  view_file {
    absolute_path_uri: "file:///src/components/TelemetryHistory.tsx"
    end_line: 39
    content: "import { useState, MouseEvent } from \'react\';\nimport { TelemetryRecord } from \'../types\';\nimport { INITIAL_TELEMETRY_RECORDS } from \'../data/mockData\';\n\ninterface TelemetryHistoryProps {\n  onInspectUrl: (url: string) => void;\n  onShowToast: (msg: string, isAlert?: boolean) => void;\n}\n\nexport default function TelemetryHistory({ onInspectUrl, onShowToast }: TelemetryHistoryProps) {\n  const [records, setRecords] = useState<TelemetryRecord[]>(INITIAL_TELEMETRY_RECORDS);\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [activeFilter, setActiveFilter] = useState<\'all\' | \'malicious\' | \'suspicious\' | \'safe\'>(\'all\');\n  const [selectedIds, setSelectedIds] = useState<string[]>([]);\n  const [activeForensicRecord, setActiveForensicRecord] = useState<TelemetryRecord | null>(null);\n\n  // Filter records\n  const filteredRecords = records.filter((rec) => {\n    const matchesFilter = activeFilter === \'all\' || rec.verdict === activeFilter;\n    const q = searchQuery.trim().toLowerCase();\n    const matchesQuery =\n      !q ||\n      rec.url.toLowerCase().includes(q) ||\n      rec.ip.toLowerCase().includes(q) ||\n      rec.trigger.toLowerCase().includes(q) ||\n      rec.host.toLowerCase().includes(q);\n    return matchesFilter && matchesQuery;\n  });\n\n  const handleSelectRecord = (id: string) => {\n    if (selectedIds.includes(id)) {\n      setSelectedIds(selectedIds.filter((item) => item !== id));\n    } else {\n      setSelectedIds([...selectedIds, id]);\n    }\n  };\n\n  const handleSelectAll = (checked: boolean) => {\n    if (checked) {\n      setSelectedIds(filteredRecords.map((r) => r.id));"
    raw_content: "import { useState, MouseEvent } from \'react\';\nimport { TelemetryRecord } from \'../types\';\nimport { INITIAL_TELEMETRY_RECORDS } from \'../data/mockData\';\n\ninterface TelemetryHistoryProps {\n  onInspectUrl: (url: string) => void;\n  onShowToast: (msg: string, isAlert?: boolean) => void;\n}\n\nexport default function TelemetryHistory({ onInspectUrl, onShowToast }: TelemetryHistoryProps) {\n  const [records, setRecords] = useState<TelemetryRecord[]>(INITIAL_TELEMETRY_RECORDS);\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [activeFilter, setActiveFilter] = useState<\'all\' | \'malicious\' | \'suspicious\' | \'safe\'>(\'all\');\n  const [selectedIds, setSelectedIds] = useState<string[]>([]);\n  const [activeForensicRecord, setActiveForensicRecord] = useState<TelemetryRecord | null>(null);\n\n  // Filter records\n  const filteredRecords = records.filter((rec) => {\n    const matchesFilter = activeFilter === \'all\' || rec.verdict === activeFilter;\n    const q = searchQuery.trim().toLowerCase();\n    const matchesQuery =\n      !q ||\n      rec.url.toLowerCase().includes(q) ||\n      rec.ip.toLowerCase().includes(q) ||\n      rec.trigger.toLowerCase().includes(q) ||\n      rec.host.toLowerCase().includes(q);\n    return matchesFilter && matchesQuery;\n  });\n\n  const handleSelectRecord = (id: string) => {\n    if (selectedIds.includes(id)) {\n      setSelectedIds(selectedIds.filter((item) => item !== id));\n    } else {\n      setSelectedIds([...selectedIds, id]);\n    }\n  };\n\n  const handleSelectAll = (checked: boolean) => {\n    if (checked) {\n      setSelectedIds(filteredRecords.map((r) => r.id));\n    } else {\n      setSelectedIds([]);\n    }\n  };\n\n  const handleDeleteRecord = (id: string, e: MouseEvent) => {\n    e.stopPropagation();\n    setRecords(records.filter((r) => r.id !== id));\n    setSelectedIds(selectedIds.filter((item) => item !== id));\n    onShowToast(\'Telemetry record purged from audit log\');\n  };\n\n  const handleBulkQuarantine = () => {\n    const count = selectedIds.length;\n    if (count === 0) return;\n    onShowToast(`Quarantined ${count} domains across network edge firewalls.`, true);\n    setSelectedIds([]);\n  };\n\n  const handleBulkExport = () => {\n    const dataToExport = records.filter((r) =>\n      selectedIds.length > 0 ? selectedIds.includes(r.id) : true\n    );\n    const csvContent =\n      \'data:text/csv;charset=utf-8,\' +\n      \'ID,URL,Verdict,Score,Trigger,Timestamp,IP\\n\' +\n      dataToExport\n        .map((r) => `\"${r.id}\",\"${r.url}\",\"${r.verdict}\",\"${r.score}\",\"${r.trigger}\",\"${r.timestamp}\",\"${r.ip}\"`)\n        .join(\'\\n\');\n    const encodedUri = encodeURI(csvContent);\n    const link = document.createElement(\'a\');\n    link.setAttribute(\'href\', encodedUri);\n    link.setAttribute(\'download\', `threat-telemetry-audit-${Date.now()}.csv`);\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n    onShowToast(`Exported ${dataToExport.length} audit records to CSV.`);\n  };\n\n  const handleIsolateOrigin = () => {\n    if (!activeForensicRecord) return;\n    onShowToast(`Origin ${activeForensicRecord.host} blacklisted in WAF edge rules.`, true);\n    setActiveForensicRecord(null);\n  };\n\n  return (\n    <div className=\"flex flex-col w-full max-w-lg mx-auto px-4 py-3 space-y-4 pb-20 text-[#dce2f7]\">\n      {/* Hero / Telemetry Header Banner */}\n      <div className=\"relative overflow-hidden rounded-xl bg-[#141b2b] p-4 shadow-lg border border-[#232a3a]/60\">\n        <div className=\"absolute -right-8 -top-8 w-44 h-44 rounded-full bg-[#a078ff]/10 blur-3xl pointer-events-none\" />\n        <div className=\"absolute -left-6 bottom-0 w-32 h-32 rounded-full bg-[#4fdbc8]/10 blur-2xl pointer-events-none\" />\n        <div className=\"relative z-10 flex flex-col space-y-2\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-1.5\">\n              <span className=\"inline-flex items-center justify-center w-6 h-6 rounded-lg bg-[#191f2f] text-[#4fdbc8]\">\n                <span className=\"material-symbols-outlined text-[16px]\">shield_with_heart</span>\n              </span>\n              <span className=\"font-label-sm text-[10px] uppercase tracking-widest text-[#4fdbc8] font-bold\">\n                SURVEILLANCE NODE #4\n              </span>\n            </div>\n            <div className=\"flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[#232a3a] text-[#cbc3d7] font-code-md text-[10px]\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-[#04b4a2] animate-pulse\" />\n              <span>SYNCED 1s AGO</span>\n            </div>\n          </div>\n\n          <div>\n            <h1 className=\"font-headline-xl-mobile text-[22px] font-bold text-[#dce2f7] tracking-tight\">\n              Threat Telemetry & Scan Audit Log\n            </h1>\n            <p className=\"font-body-sm text-xs text-[#cbc3d7] mt-0.5\">\n              Historical records across automated API & manual browser scans\n            </p>\n          </div>\n\n          {/* Metric KPI Tiles */}\n          <div className=\"grid grid-cols-3 gap-2 pt-2\">\n            <div className=\"flex flex-col p-2.5 rounded-lg bg-[#191f2f] shadow-sm border border-[#232a3a]/40\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-label-sm text-[9px] text-[#cbc3d7] uppercase\">SCANNED</span>\n                <span className=\"material-symbols-outlined text-[14px] text-[#d0bcff]\">radar</span>\n              </div>\n              <span className=\"font-headline-md text-base sm:text-lg font-bold text-[#dce2f7] mt-0.5\">1,420</span>\n              <span className=\"font-label-sm text-[10px] text-[#4fdbc8] flex items-center gap-0.5 mt-0.5 font-mono\">\n                <span className=\"material-symbols-outlined text-[12px]\">trending_up</span>+18.4%\n              </span>\n            </div>\n\n            <div className=\"flex flex-col p-2.5 rounded-lg bg-[#191f2f] shadow-sm border border-[#232a3a]/40\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-label-sm text-[9px] text-[#cbc3d7] uppercase\">QUARANTINED</span>\n                <span className=\"material-symbols-outlined text-[14px] text-[#ffb4ab]\">gpp_bad</span>\n              </div>\n              <span className=\"font-headline-md text-base sm:text-lg font-bold text-[#ffb4ab] mt-0.5\">184</span>\n              <span className=\"font-label-sm text-[10px] text-[#ffb4ab]/80 flex items-center gap-0.5 mt-0.5 font-mono\">\n                <span className=\"material-symbols-outlined text-[12px]\">security_update_warning</span>Active\n              </span>\n            </div>\n\n            <div className=\"flex flex-col p-2.5 rounded-lg bg-[#191f2f] shadow-sm border border-[#232a3a]/40\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-label-sm text-[9px] text-[#cbc3d7] uppercase\">FALSE POS.</span>\n                <span className=\"material-symbols-outlined text-[14px] text-[#4fdbc8]\">verified_user</span>\n              </div>\n              <span className=\"font-headline-md text-base sm:text-lg font-bold text-[#dce2f7] mt-0.5\">42</span>\n              <span className=\"font-label-sm text-[10px] text-[#71f8e4] flex items-center gap-0.5 mt-0.5 font-mono\">\n                <span className=\"material-symbols-outlined text-[12px]\">check</span>Cleared\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Search & Filter Controls */}\n      <div className=\"flex flex-col space-y-2\">\n        {/* Omnibar Search */}\n        <div className=\"relative flex items-center w-full bg-[#141b2b] rounded-xl px-3 py-2 shadow-sm border border-[#232a3a] focus-within:border-[#a078ff] transition-all\">\n          <span className=\"material-symbols-outlined text-[#cbc3d7] mr-2 text-[20px]\">search</span>\n          <input\n            id=\"telemetry-search-input\"\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"Filter by domain, IP, or hash...\"\n            className=\"w-full bg-transparent font-code-md text-xs text-[#dce2f7] placeholder:text-[#958ea0] focus:outline-none\"\n          />\n          {searchQuery && (\n            <button\n              onClick={() => setSearchQuery(\'\')}\n              className=\"w-6 h-6 flex items-center justify-center rounded-full bg-[#232a3a] text-[#cbc3d7] hover:text-[#dce2f7]\"\n            >\n              <span className=\"material-symbols-outlined text-[14px]\">close</span>\n            </button>\n          )}\n        </div>\n\n        {/* Filter Pills Horizontal Carousel */}\n        <div className=\"flex items-center gap-2 overflow-x-auto py-1 scrollbar-none\">\n          <button\n            onClick={() => setActiveFilter(\'all\')}\n            className={`flex-shrink-0 px-3 py-1.5 rounded-full font-label-md text-[11px] transition-all flex items-center gap-1.5 shadow-sm ${\n              activeFilter === \'all\'\n                ? \'bg-[#d0bcff] text-[#3c0091] font-bold\'\n                : \'bg-[#141b2b] hover:bg-[#191f2f] text-[#dce2f7] border border-[#232a3a]\'\n            }`}\n          >\n            <span>All Verdicts</span>\n            <span className=\"px-1.5 py-0.2 rounded-full bg-black/20 text-[9px] font-bold font-mono\">1.4K</span>\n          </button>\n\n          <button\n            onClick={() => setActiveFilter(\'malicious\')}\n            className={`flex-shrink-0 px-3 py-1.5 rounded-full font-label-md text-[11px] transition-all flex items-center gap-1.5 border border-[#232a3a] ${\n              activeFilter === \'malicious\'\n                ? \'bg-[#93000a] text-[#ffdad6] font-bold border-[#ff5451]\'\n                : \'bg-[#141b2b] hover:bg-[#191f2f] text-[#dce2f7]\'\n            }`}\n          >\n            <span className=\"w-2 h-2 rounded-full bg-[#ff5451] shadow-[0_0_8px_rgba(255,84,81,0.8)]\" />\n            <span>Malicious</span>\n            <span className=\"font-code-md text-[#ffdad6] text-[10px]\">(640)</span>\n          </button>\n\n          <button\n            onClick={() => setActiveFilter(\'suspicious\')}\n            className={`flex-shrink-0 px-3 py-1.5 rounded-full font-label-md text-[11px] transition-all flex items-center gap-1.5 border border-[#232a3a] ${\n              activeFilter === \'suspicious\'\n                ? \'bg-[#232a3a] text-[#ffb3ad] font-bold border-[#ffb3ad]\'\n                : \'bg-[#141b2b] hover:bg-[#191f2f] text-[#dce2f7]\'\n            }`}\n          >\n            <span className=\"w-2 h-2 rounded-full bg-[#04b4a2] shadow-[0_0_8px_rgba(4,180,162,0.8)]\" />\n            <span>Suspicious</span>\n            <span className=\"font-code-md text-[#4fdbc8] text-[10px]\">(184)</span>\n          </button>\n\n          <button\n            onClick={() => setActiveFilter(\'safe\')}\n            className={`flex-shrink-0 px-3 py-1.5 rounded-full font-label-md text-[11px] transition-all flex items-center gap-1.5 border border-[#232a3a] ${\n              activeFilter === \'safe\'\n                ? \'bg-[#04b4a2] text-[#003f38] font-bold\'\n                : \'bg-[#141b2b] hover:bg-[#191f2f] text-[#dce2f7]\'\n            }`}\n          >\n            <span className=\"w-2 h-2 rounded-full bg-[#4fdbc8] shadow-[0_0_8px_rgba(79,219,200,0.8)]\" />\n            <span>Safe</span>\n            <span className=\"font-code-md text-[#4fdbc8] text-[10px]\">(596)</span>\n          </button>\n\n          <button\n            onClick={handleBulkExport}\n            className=\"flex-shrink-0 px-3 py-1.5 rounded-full bg-[#141b2b] text-[#d0bcff] hover:bg-[#191f2f] font-label-md text-[11px] transition-all flex items-center gap-1 border border-[#232a3a]\"\n          >\n            <span className=\"material-symbols-outlined text-[14px]\">file_download</span>\n            <span>Export CSV</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Telemetry Records Feed */}\n      <div className=\"flex flex-col space-y-3\">\n        {filteredRecords.length === 0 ? (\n          <div className=\"flex flex-col items-center justify-center text-center p-8 bg-[#141b2b] rounded-xl space-y-3 border border-[#232a3a]\">\n            <div className=\"w-16 h-16 rounded-full bg-[#2e3545] flex items-center justify-center text-[#d0bcff]\">\n              <span className=\"material-symbols-outlined text-[32px]\">manage_search</span>\n            </div>\n            <div className=\"space-y-1\">\n              <h3 className=\"font-headline-sm text-sm text-[#dce2f7] font-bold\">No Telemetry Matches</h3>\n              <p className=\"font-body-sm text-xs text-[#cbc3d7] max-w-xs\">\n                No scan events match your current filter parameters or search terms.\n              </p>\n            </div>\n            <button\n              onClick={() => {\n                setSearchQuery(\'\');\n                setActiveFilter(\'all\');\n              }}\n              className=\"px-4 py-2 rounded-lg bg-[#d0bcff] text-[#3c0091] font-label-md text-xs uppercase tracking-wider font-bold shadow\"\n            >\n              Reset Filters\n            </button>\n          </div>\n        ) : (\n          filteredRecords.map((rec) => {\n            const isMal = rec.verdict === \'malicious\';\n            const isSus = rec.verdict === \'suspicious\';\n            const isSelected = selectedIds.includes(rec.id);\n\n            return (\n              <article\n                key={rec.id}\n                onClick={() => onInspectUrl(rec.url)}\n                className=\"telemetry-card relative overflow-hidden rounded-xl bg-[#141b2b] p-3.5 shadow-md transition-all active:scale-[0.99] flex flex-col space-y-2 border border-[#232a3a]/60 hover:border-[#a078ff]/40 cursor-pointer\"\n              >\n                {/* Lateral accent strip */}\n                <div\n                  className={`absolute left-0 top-0 bottom-0 w-1 ${\n                    isMal\n                      ? \'bg-[#ff5451] shadow-[0_0_12px_rgba(255,84,81,0.9)]\'\n                      : isSus\n                      ? \'bg-[#04b4a2] shadow-[0_0_10px_rgba(4,180,162,0.8)]\'\n                      : \'bg-[#4fdbc8] shadow-[0_0_10px_rgba(79,219,200,0.6)]\'\n                  }`}\n                />\n\n                {/* Header Row: Checkbox + Verdict pill + Score */}\n                <div className=\"flex items-start justify-between gap-2 pl-1\">\n                  <div className=\"flex items-center gap-2\">\n                    <input\n                      type=\"checkbox\"\n                      aria-label=\"Select Record\"\n                      checked={isSelected}\n                      onClick={(e) => e.stopPropagation()}\n                      onChange={() => handleSelectRecord(rec.id)}\n                      className=\"w-4 h-4 rounded bg-[#2e3545] accent-[#a078ff] cursor-pointer\"\n                    />\n                    <span\n                      className={`px-2 py-0.5 rounded-full font-label-sm text-[9px] tracking-wider uppercase font-bold flex items-center gap-1 ${\n                        isMal\n                          ? \'bg-[#93000a] text-[#ffdad6]\'\n                          : isSus\n                          ? \'bg-[#04b4a2]/20 text-[#4fdbc8]\'\n                          : \'bg-[#4fdbc8]/15 text-[#4fdbc8]\'\n                      }`}\n                    >\n                      <span\n                        className={`w-1.5 h-1.5 rounded-full ${\n                          isMal ? \'bg-[#ff5451] animate-ping\' : isSus ? \'bg-[#04b4a2]\' : \'bg-[#4fdbc8]\'\n                        }`}\n                      />\n                      {rec.verdictLabel}\n                    </span>\n                  </div>\n\n                  <div\n                    className={`flex items-center gap-1 px-2 py-0.5 rounded-lg bg-[#191f2f] font-code-md text-xs font-bold ${\n                      isMal ? \'text-[#ffb4ab]\' : isSus ? \'text-[#ffb3ad]\' : \'text-[#4fdbc8]\'\n                    }`}\n                  >\n                    <span className=\"material-symbols-outlined text-[14px]\">\n                      {isMal ? \'warning\' : isSus ? \'bolt\' : \'verified\'}\n                    </span>\n                    <span>{String(rec.score).padStart(2, \'0\')}/100</span>\n                  </div>\n                </div>\n\n                {/* Domain & Trigger */}\n                <div className=\"pl-1 space-y-0.5\">\n                  <div className=\"flex items-center gap-1 text-[#dce2f7] font-code-md text-xs sm:text-[13px] break-all\">\n                    <span className=\"text-[#958ea0] font-normal\">{rec.protocol}</span>\n                    <span\n                      className={`font-semibold ${\n                        isMal\n                          ? \'text-[#ffb4ab] underline decoration-[#ffb4ab]/50\'\n                          : isSus\n                          ? \'text-[#4fdbc8]\'\n                          : \'text-[#4fdbc8]\'\n                      }`}\n                    >\n                      {rec.host}\n                    </span>\n                    {rec.path && <span className=\"text-[#cbc3d7]\">{rec.path}</span>}\n                  </div>\n                  <div\n                    className={`flex items-center gap-1.5 text-xs ${\n                      isMal ? \'text-[#ffb3ad]\' : isSus ? \'text-[#71f8e4]\' : \'text-[#cbc3d7]\'\n                    }`}\n                  >\n                    <span className=\"material-symbols-outlined text-[14px]\">\n                      {isMal ? \'report_problem\' : isSus ? \'currency_exchange\' : \'check_circle\'}\n                    </span>\n                    <span className=\"truncate\">{rec.trigger}</span>\n                  </div>\n                </div>\n\n                {/* Metadata & Actions row */}\n                <div className=\"pl-1 pt-1 flex flex-wrap items-center justify-between gap-y-1 font-label-sm text-[10px] text-[#cbc3d7] border-t border-[#232a3a]/40\">\n                  <div className=\"flex items-center gap-3\">\n                    <span className=\"flex items-center gap-1\">\n                      <span className=\"material-symbols-outlined text-[12px]\">schedule</span> {rec.timestamp}\n                    </span>\n                    <span className=\"flex items-center gap-1 font-mono\">\n                      <span className=\"material-symbols-outlined text-[12px]\">dns</span> {rec.ip}\n                    </span>\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    <button\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        setActiveForensicRecord(rec);\n                      }}\n                      className=\"px-2.5 py-1 rounded bg-[#232a3a] hover:bg-[#323949] text-[#d0bcff] font-code-md text-[10px] uppercase tracking-wider flex items-center gap-1 transition-colors border border-[#232a3a]\"\n                    >\n                      <span className=\"material-symbols-outlined text-[13px]\">biotech</span>\n                      <span>Forensics</span>\n                    </button>\n                    <button\n                      aria-label=\"Delete Log\"\n                      onClick={(e) => handleDeleteRecord(rec.id, e)}\n                      className=\"w-7 h-7 rounded bg-[#232a3a] hover:bg-[#93000a] text-[#cbc3d7] hover:text-[#ffdad6] flex items-center justify-center transition-colors\"\n                    >\n                      <span className=\"material-symbols-outlined text-[15px]\">delete</span>\n                    </button>\n                  </div>\n                </div>\n              </article>\n            );\n          })\n        )}\n      </div>\n\n      {/* Batch Selection Tactical Footer */}\n      <div className=\"sticky bottom-20 z-30 flex items-center justify-between p-3 rounded-xl bg-[#232a3a]/90 backdrop-blur-lg shadow-2xl border border-[#232a3a]\">\n        <div className=\"flex items-center gap-2\">\n          <input\n            id=\"select-all-checkbox\"\n            type=\"checkbox\"\n            aria-label=\"Select all telemetry records\"\n            checked={\n              filteredRecords.length > 0 && selectedIds.length === filteredRecords.length\n            }\n            onChange={(e) => handleSelectAll(e.target.checked)}\n            className=\"w-4 h-4 rounded bg-[#191f2f] accent-[#a078ff] cursor-pointer\"\n          />\n          <label\n            htmlFor=\"select-all-checkbox\"\n            className=\"font-label-sm text-[10px] text-[#dce2f7] font-code-md cursor-pointer select-none\"\n          >\n            Select all ({selectedIds.length}/{filteredRecords.length})\n          </label>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <button\n            disabled={selectedIds.length === 0}\n            onClick={handleBulkQuarantine}\n            className=\"px-3 py-1.5 rounded-lg bg-[#93000a] hover:bg-[#ff5451] text-[#ffdad6] hover:text-white font-label-sm text-[10px] uppercase tracking-wider font-bold flex items-center gap-1 transition-all disabled:opacity-40 disabled:pointer-events-none shadow\"\n          >\n            <span className=\"material-symbols-outlined text-[14px]\">security</span>\n            <span>Bulk Quarantine</span>\n          </button>\n          <button\n            onClick={handleBulkExport}\n            className=\"px-3 py-1.5 rounded-lg bg-[#191f2f] hover:bg-[#323949] text-[#dce2f7] font-label-sm text-[10px] uppercase tracking-wider flex items-center gap-1 transition-all border border-[#232a3a]\"\n          >\n            <span className=\"material-symbols-outlined text-[14px]\">ios_share</span>\n            <span>Export</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Forensics Modal Drawer (Overlay) */}\n      {activeForensicRecord && (\n        <div className=\"fixed inset-0 z-50 flex items-end justify-center\">\n          <div\n            className=\"fixed inset-0 bg-[#070e1d]/85 backdrop-blur-sm transition-opacity\"\n            onClick={() => setActiveForensicRecord(null)}\n          />\n          <div className=\"relative w-full max-w-lg bg-[#070e1d] border border-[#232a3a] p-4 rounded-t-2xl shadow-2xl space-y-4 max-h-[85vh] overflow-y-auto z-10 animate-slideUp\">\n            <div className=\"w-12 h-1.5 rounded-full bg-[#2e3545] mx-auto\" />\n\n            <div className=\"flex items-center justify-between border-b border-[#232a3a] pb-3\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"material-symbols-outlined text-[#d0bcff] text-[24px]\">troubleshoot</span>\n                <div>\n                  <h2 className=\"font-headline-sm text-base font-bold text-[#dce2f7]\">Deep Threat Forensics</h2>\n                  <span className=\"font-label-sm text-xs text-[#4fdbc8] font-code-md\">\n                    {activeForensicRecord.host}\n                  </span>\n                </div>\n              </div>\n              <button\n                onClick={() => setActiveForensicRecord(null)}\n                className=\"w-8 h-8 flex items-center justify-center rounded-full bg-[#191f2f] text-[#cbc3d7]\"\n              >\n                <span className=\"material-symbols-outlined text-[20px]\">close</span>\n              </button>\n            </div>\n\n            <div className=\"space-y-3\">\n              <div className=\"p-2.5 rounded-lg bg-[#191f2f] font-code-md text-xs text-[#dce2f7] space-y-1 border border-[#232a3a]\">\n                <div className=\"flex justify-between text-[#cbc3d7] font-label-sm text-[10px]\">\n                  <span>NEURAL ENGINE HEURISTICS</span>\n                  <span className=\"text-[#d0bcff] font-bold\">\n                    {activeForensicRecord.details?.confidence || \'99.4% CONFIDENCE\'}\n                  </span>\n                </div>\n                <div className=\"w-full bg-[#2e3545] h-2 rounded-full overflow-hidden\">\n                  <div\n                    className=\"bg-gradient-to-r from-[#a078ff] via-[#ff5451] to-[#ffb4ab] h-full\"\n                    style={{ width: `${Math.max(activeForensicRecord.score, 4)}%` }}\n                  />\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-2\">\n                <div className=\"p-2.5 rounded-lg bg-[#191f2f] border border-[#232a3a]\">\n                  <span className=\"font-label-sm text-[9px] text-[#958ea0] uppercase block\">REGISTRAR</span>\n                  <span className=\"font-body-sm text-xs text-[#dce2f7] font-code-md font-semibold\">\n                    {activeForensicRecord.details?.registrar || \'NameCheap / Offshore\'}\n                  </span>\n                </div>\n                <div className=\"p-2.5 rounded-lg bg-[#191f2f] border border-[#232a3a]\">\n                  <span className=\"font-label-sm text-[9px] text-[#958ea0] uppercase block\">DNS TTL</span>\n                  <span className=\"font-body-sm text-xs text-[#dce2f7] font-code-md font-semibold\">\n                    {activeForensicRecord.details?.dnsTtl || \'60s (Fast-Flux)\'}\n                  </span>\n                </div>\n              </div>\n\n              <div className=\"p-2.5 rounded-lg bg-[#191f2f] font-code-md text-xs space-y-1 border border-[#232a3a]\">\n                <span className=\"font-label-sm text-[9px] text-[#958ea0] uppercase block\">\n                  CANVAS & DOM ATTACK VECTOR\n                </span>\n                <p className=\"text-[#ffb3ad] text-xs leading-relaxed\">\n                  {activeForensicRecord.details?.domVector ||\n                    \'Cloned CSS assets mimic enterprise portal with base64 encoded credential postback payload.\'}\n                </p>\n              </div>\n            </div>\n\n            <div className=\"flex gap-2 pt-2 border-t border-[#232a3a]\">\n              <button\n                onClick={handleIsolateOrigin}\n                className=\"flex-1 py-2.5 rounded-lg bg-[#93000a] hover:bg-[#ff5451] text-[#ffdad6] hover:text-white font-label-md text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-1.5 transition-colors shadow\"\n              >\n                <span className=\"material-symbols-outlined text-[16px]\">block</span>\n                <span>Isolate Origin</span>\n              </button>\n              <button\n                onClick={() => {\n                  onInspectUrl(activeForensicRecord.url);\n                  setActiveForensicRecord(null);\n                }}\n                className=\"px-4 py-2.5 rounded-lg bg-[#a078ff] text-[#340080] font-label-md text-xs font-bold uppercase tracking-wider\"\n              >\n                Open in Scanner\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n"
    num_lines: 528
    num_bytes: 26281
  }
}
