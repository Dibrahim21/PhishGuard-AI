  file_change {
    absolute_path_uri: "file:///src/components/NeuralUrlScanner.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useEffect } from \'react\';\nimport { analyzeUrl, ScanAnalysisResult } from \'../utils/threatEngine\';\n\ninterface NeuralUrlScannerProps {\n  initialUrl?: string;\n  onNavigateToLogs?: () => void;\n  onShowToast: (msg: string, isAlert?: boolean) => void;\n}\n\nexport default function NeuralUrlScanner({ initialUrl, onShowToast }: NeuralUrlScannerProps) {\n  const [urlInput, setUrlInput] = useState(\n    initialUrl || \'https://secure-login.wellsfarg0-verify.com/auth/account-update\'\n  );\n  const [isAnalyzing, setIsAnalyzing] = useState(false);\n  const [analysis, setAnalysis] = useState<ScanAnalysisResult>(() =>\n    analyzeUrl(initialUrl || \'https://secure-login.wellsfarg0-verify.com/auth/account-update\')\n  );\n  const [quarantined, setQuarantined] = useState(false);\n  const [showPacketDump, setShowPacketDump] = useState(false);\n\n  useEffect(() => {\n    if (initialUrl && initialUrl !== urlInput) {\n      setUrlInput(initialUrl);\n      setAnalysis(analyzeUrl(initialUrl));\n      setQuarantined(false);\n    }\n  }, [initialUrl]);\n\n  const handleScan = (urlToScan?: string) => {\n    const target = urlToScan || urlInput;\n    if (!target.trim()) return;\n\n    setIsAnalyzing(true);\n    setTimeout(() => {\n      const result = analyzeUrl(target);\n      setAnalysis(result);\n      setIsAnalyzing(false);\n      setQuarantined(false);\n      onShowToast(`Neural diagnostic completed: ${result.score}/100 (${result.verdictLabel})`, result.verdict === \'malicious\');\n    }, 600);\n  };\n\n  const handlePaste = async () => {\n    try {\n      if (navigator.clipboard && navigator.clipboard.readText) {\n        const text = await navigator.clipboard.readText();\n        if (text) {\n          setUrlInput(text);\n          handleScan(text);\n          return;\n        }\n      }\n    } catch {\n      // Fallback\n    }\n    const sample = \'https://portal-auth.wellsfarg0-account.net/login\';\n    setUrlInput(sample);\n    handleScan(sample);\n  };\n\n  const handleClear = () => {\n    setUrlInput(\'\');\n  };\n\n  const handleQuarantine = () => {\n    setQuarantined(!quarantined);\n    if (!quarantined) {\n      onShowToast(`Origin ${analysis.host} quarantined across network edge firewalls!`, true);\n    } else {\n      onShowToast(`Quarantine removed for ${analysis.host}`);\n    }\n  };\n\n  const handleExportStix = () => {\n    const stixBundle = {\n      type: \'bundle\',\n      id: `bundle--${Math.random().toString(36).substring(2, 10)}`,\n      spec_version: \'2.1\',\n      objects: [\n        {\n          type: \'indicator\',\n          id: `indicator--${Math.random().toString(36).substring(2, 10)}`,\n          created: new Date().toISOString(),\n          pattern: `[url:value = \'${analysis.url}\']`,\n          pattern_type: \'stix\',\n          valid_from: new Date().toISOString(),\n          name: `Malicious URL: ${analysis.host}`,\n          description: analysis.threatBannerDesc,\n          confidence: 99,\n          indicator_types: [\'malicious-activity\', \'phishing\'],\n          labels: [\'phishing\', \'typosquatting\', \'credential-harvesting\'],\n        },\n        {\n          type: \'observed-data\',\n          id: `observed-data--${Math.random().toString(36).substring(2, 10)}`,\n          first_observed: new Date().toISOString(),\n          number_observed: 1,\n          objects: {\n            \'0\': { type: \'domain-name\', value: analysis.host },\n            \'1\': { type: \'ipv4-addr\', value: \'185.220.101.5\' },\n          },\n        },\n      ],\n    };\n\n    const blob = new Blob([JSON.stringify(stixBundle, null, 2)], { type: \'application/json\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `stix-ioc-${analysis.host.replace(/[^a-z0-9]/gi, \'_\')}.json`;\n    a.click();\n    URL.revokeObjectURL(url);\n    onShowToast(\'STIX 2.1 IOC Bundle generated & downloaded\');\n  };\n\n  // Circumference for r=50 is 2 * PI * 50 = 314.159\n  const circumference = 314.159;\n  const strokeOffset = circumference - (analysis.score / 100) * circumference;\n\n  return (\n    <div className=\"flex flex-col w-full max-w-lg mx-auto px-4 py-4 gap-6 text-[#dce2f7]\">\n      {/* 1. URL SCANNER INPUT SECTION */}\n      <section className=\"flex flex-col gap-3\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-[#4fdbc8] text-[18px]\">travel_explore</span>\n            <span className=\"font-label-sm text-[10px] uppercase tracking-widest text-[#4fdbc8] font-bold\">\n              Neural URL Interceptor\n            </span>\n          </div>\n          <span className=\"font-label-sm text-[10px] text-[#958ea0] px-2 py-0.5 bg-[#232a3a] rounded-full font-mono\">\n            v4.8.2-NEURAL\n          </span>\n        </div>\n\n        {/* The Omnibar */}\n        <div className=\"relative flex items-center bg-[#070e1d] rounded-xl shadow-lg p-2 border border-[#232a3a]/80 focus-within:border-[#a078ff] transition-all\">\n          <div className=\"flex items-center pl-1 text-[#cbc3d7]\">\n            <span className=\"material-symbols-outlined text-[20px] text-[#4fdbc8]\">shield_lock</span>\n          </div>\n          <input\n            id=\"url-input\"\n            aria-label=\"URL to analyze\"\n            type=\"text\"\n            value={urlInput}\n            onChange={(e) => setUrlInput(e.target.value)}\n            onKeyDown={(e) => e.key === \'Enter\' && handleScan()}\n            placeholder=\"https://suspicious-domain-to-inspect.com/auth\"\n            className=\"w-full bg-transparent px-2.5 font-code-md text-xs sm:text-[13px] text-[#dce2f7] focus:outline-none min-w-0 placeholder:text-[#958ea0]\"\n          />\n          {urlInput && (\n            <button\n              id=\"clear-btn\"\n              onClick={handleClear}\n              aria-label=\"Clear URL\"\n              className=\"w-8 h-8 flex items-center justify-center text-[#494454] hover:text-[#dce2f7] transition-colors\"\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">cancel</span>\n            </button>\n          )}\n        </div>\n\n        {/* Action Trigger Controls */}\n        <div className=\"flex items-center gap-2\">\n          <button\n            id=\"paste-btn\"\n            onClick={handlePaste}\n            className=\"flex-1 h-11 flex items-center justify-center gap-2 bg-[#191f2f] hover:bg-[#232a3a] active:scale-[0.98] text-[#dce2f7] font-label-md text-[11px] uppercase tracking-wider rounded-xl transition-all border border-[#232a3a]\"\n          >\n            <span className=\"material-symbols-outlined text-[18px]\">content_paste</span>\n            <span>Paste URL</span>\n          </button>\n          <button\n            id=\"scan-btn\"\n            onClick={() => handleScan()}\n            disabled={isAnalyzing}\n            className=\"flex-[1.4] h-11 flex items-center justify-center gap-2 bg-gradient-to-r from-[#d0bcff] to-[#4fdbc8] text-[#3c0091] font-label-md text-[11px] uppercase tracking-wider font-bold rounded-xl shadow-[0_0_24px_-4px_rgba(208,188,255,0.4)] active:scale-[0.98] transition-all hover:brightness-105 disabled:opacity-50\"\n          >\n            <span className={`material-symbols-outlined text-[18px] ${isAnalyzing ? \'animate-spin\' : \'\'}`}>\n              {isAnalyzing ? \'refresh\' : \'radar\'}\n            </span>\n            <span>{isAnalyzing ? \'Analyzing...\' : \'Rescan Target\'}</span>\n          </button>\n        </div>\n\n        {/* Scan Telemetry Ping */}\n        <div className=\"flex items-center justify-between px-2 py-1.5 bg-[#141b2b] rounded-lg border border-[#232a3a]/40\">\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-[#4fdbc8]\" />\n            <span className=\"font-label-sm text-[10px] text-[#cbc3d7]\">Deep Heuristics Engine</span>\n          </div>\n          <span className=\"font-code-md text-xs text-[#4fdbc8] font-semibold\">142ms Telemetry</span>\n        </div>\n      </section>\n\n      {/* 2. VERDICT BANNER */}\n      {analysis.verdict === \'malicious\' ? (\n        <section className=\"relative overflow-hidden rounded-xl bg-[#93000a] text-[#ffdad6] p-4 shadow-[0_0_32px_-4px_rgba(147,0,10,0.45)] border border-[#ff5451]/30\">\n          <div className=\"absolute -right-6 -bottom-6 w-32 h-32 bg-[#ffb4ab]/15 rounded-full blur-2xl pointer-events-none\" />\n          <div className=\"flex items-start gap-3 relative z-10\">\n            <div className=\"w-10 h-10 rounded-lg bg-[#690005] flex items-center justify-center text-[#ffb4ab] shrink-0 shadow-md\">\n              <span className=\"material-symbols-outlined text-[24px]\">gpp_maybe</span>\n            </div>\n            <div className=\"flex flex-col gap-1 min-w-0\">\n              <div className=\"flex items-center gap-2 flex-wrap\">\n                <span className=\"font-label-sm text-[9px] uppercase tracking-widest bg-[#690005] px-2 py-0.5 rounded-full text-[#ffb4ab] font-bold\">\n                  CRITICAL PHISHING THREAT\n                </span>\n                <span className=\"font-label-sm text-[10px] text-[#ffb4ab] uppercase font-mono\">Active Zero-Day</span>\n              </div>\n              <h2 className=\"font-headline-sm text-sm sm:text-base text-[#ffb4ab] font-bold leading-snug\">\n                {analysis.threatBannerTitle}\n              </h2>\n              <p className=\"font-body-sm text-xs text-[#ffdad6] pt-1\">\n                {analysis.threatBannerDesc}\n              </p>\n            </div>\n          </div>\n        </section>\n      ) : analysis.verdict === \'suspicious\' ? (\n        <section className=\"relative overflow-hidden rounded-xl bg-[#232a3a] text-[#ffb3ad] p-4 shadow-lg border border-[#ffb3ad]/40\">\n          <div className=\"flex items-start gap-3\">\n            <div className=\"w-10 h-10 rounded-lg bg-[#2e3545] flex items-center justify-center text-[#ffb3ad] shrink-0\">\n              <span className=\"material-symbols-outlined text-[24px]\">warning</span>\n            </div>\n            <div className=\"flex flex-col gap-1\">\n              <span className=\"font-label-sm text-[9px] uppercase tracking-widest bg-[#ff5451]/20 px-2 py-0.5 rounded-full text-[#ffb3ad] font-bold inline-block w-max\">\n                SUSPICIOUS ANOMALY\n              </span>\n              <h2 className=\"font-headline-sm text-base text-[#dce2f7] font-bold leading-snug\">\n                {analysis.threatBannerTitle}\n              </h2>\n              <p className=\"font-body-sm text-xs text-[#cbc3d7]\">\n                {analysis.threatBannerDesc}\n              </p>\n            </div>\n          </div>\n        </section>\n      ) : (\n        <section className=\"relative overflow-hidden rounded-xl bg-[#141b2b] text-[#4fdbc8] p-4 shadow-lg border border-[#4fdbc8]/40\">\n          <div className=\"flex items-start gap-3\">\n            <div className=\"w-10 h-10 rounded-lg bg-[#191f2f] flex items-center justify-center text-[#4fdbc8] shrink-0\">\n              <span className=\"material-symbols-outlined text-[24px]\">verified</span>\n            </div>\n            <div className=\"flex flex-col gap-1\">\n              <span className=\"font-label-sm text-[9px] uppercase tracking-widest bg-[#4fdbc8]/20 px-2 py-0.5 rounded-full text-[#4fdbc8] font-bold inline-block w-max\">\n                VERIFIED SAFE\n              </span>\n              <h2 className=\"font-headline-sm text-base text-[#dce2f7] font-bold leading-snug\">\n                {analysis.threatBannerTitle}\n              </h2>\n              <p className=\"font-body-sm text-xs text-[#cbc3d7]\">\n                {analysis.threatBannerDesc}\n              </p>\n            </div>\n          </div>\n        </section>\n      )}\n\n      {/* 3. NEURAL RISK SCORE CARD (0-100 DIAL) */}\n      <section className=\"flex flex-col bg-[#191f2f] rounded-xl p-4 gap-4 shadow-xl border border-[#232a3a]\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <span\n              className={`material-symbols-outlined text-[20px] ${\n                analysis.verdict === \'malicious\'\n                  ? \'text-[#ffb4ab]\'\n                  : analysis.verdict === \'suspicious\'\n                  ? \'text-[#ffb3ad]\'\n                  : \'text-[#4fdbc8]\'\n              }`}\n            >\n              analytics\n            </span>\n            <span className=\"font-label-md text-[11px] uppercase tracking-wider text-[#cbc3d7]\">\n              Neural Threat Assessment\n            </span>\n          </div>\n          <span\n            className={`font-label-sm text-[10px] px-2.5 py-1 rounded-full font-bold uppercase ${\n              analysis.verdict === \'malicious\'\n                ? \'text-[#ffb4ab] bg-[#93000a]\'\n                : analysis.verdict === \'suspicious\'\n                ? \'text-[#ffb3ad] bg-[#2e3545]\'\n                : \'text-[#4fdbc8] bg-[#4fdbc8]/15\'\n            }`}\n          >\n            {analysis.verdict === \'malicious\'\n              ? \'HIGH RISK \342\200\242 MALICIOUS\'\n              : analysis.verdict === \'suspicious\'\n              ? \'MODERATE RISK \342\200\242 SUSPICIOUS\'\n              : \'LOW RISK \342\200\242 BENIGN\'}\n          </span>\n        </div>\n\n        {/* Circular Dial Visual Display */}\n        <div className=\"flex flex-col items-center justify-center py-2 relative\">\n          <div className=\"relative w-44 h-44 flex items-center justify-center\">\n            <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 120 120\">\n              <circle\n                className=\"text-[#232a3a]\"\n                cx=\"60\"\n                cy=\"60\"\n                fill=\"transparent\"\n                r=\"50\"\n                stroke=\"currentColor\"\n                strokeWidth=\"8\"\n              />\n              <circle\n                className={\n                  analysis.verdict === \'malicious\'\n                    ? \'text-[#ff5451]\'\n                    : analysis.verdict === \'suspicious\'\n                    ? \'text-[#ffb3ad]\'\n                    : \'text-[#4fdbc8]\'\n                }\n                cx=\"60\"\n                cy=\"60\"\n                fill=\"transparent\"\n                r=\"50\"\n                stroke=\"currentColor\"\n                strokeDasharray={circumference}\n                strokeDashoffset={strokeOffset}\n                strokeLinecap=\"round\"\n                strokeWidth=\"9\"\n              />\n            </svg>\n            <div className=\"absolute flex flex-col items-center justify-center\">\n              <span\n                className={`font-headline-xl text-4xl font-bold tracking-tight ${\n                  analysis.verdict === \'malicious\'\n                    ? \'text-[#ffb4ab]\'\n                    : analysis.verdict === \'suspicious\'\n                    ? \'text-[#ffb3ad]\'\n                    : \'text-[#4fdbc8]\'\n                }`}\n              >\n                {analysis.score}\n              </span>\n              <span className=\"font-label-sm text-[10px] uppercase tracking-widest text-[#958ea0]\">\n                OUT OF 100\n              </span>\n            </div>\n          </div>\n          <p\n            className={`font-label-md text-xs tracking-wide font-semibold mt-2 ${\n              analysis.verdict === \'malicious\'\n                ? \'text-[#ffb4ab]\'\n                : analysis.verdict === \'suspicious\'\n                ? \'text-[#ffb3ad]\'\n                : \'text-[#4fdbc8]\'\n            }`}\n          >\n            Confidence Index: {analysis.confidence}\n          </p>\n        </div>\n\n        {/* Sub-Metrics Ticker Row */}\n        <div className=\"grid grid-cols-3 gap-2 pt-1 border-t border-[#232a3a]/40\">\n          <div className=\"flex flex-col items-center justify-center bg-[#141b2b] p-2 rounded-lg text-center border border-[#232a3a]/50\">\n            <span className=\"font-label-sm text-[9px] uppercase text-[#958ea0]\">Domain Age</span>\n            <span\n              className={`font-headline-sm text-sm font-bold mt-0.5 ${\n                analysis.verdict === \'malicious\' ? \'text-[#ffb4ab]\' : \'text-[#dce2f7]\'\n              }`}\n            >\n              {analysis.domainAge}\n            </span>\n            <span\n              className={`font-label-sm text-[9px] ${\n                analysis.verdict === \'malicious\' ? \'text-[#ffb4ab]\' : \'text-[#4fdbc8]\'\n              }`}\n            >\n              {analysis.domainAgeLabel}\n            </span>\n          </div>\n\n          <div className=\"flex flex-col items-center justify-center bg-[#141b2b] p-2 rounded-lg text-center border border-[#232a3a]/50\">\n            <span className=\"font-label-sm text-[9px] uppercase text-[#958ea0]\">Heuristics</span>\n            <span\n              className={`font-headline-sm text-sm font-bold mt-0.5 ${\n                analysis.verdict === \'malicious\' ? \'text-[#ffb4ab]\' : \'text-[#dce2f7]\'\n              }`}\n            >\n              {analysis.heuristicsPercent}\n            </span>\n            <span\n              className={`font-label-sm text-[9px] ${\n                analysis.verdict === \'malicious\' ? \'text-[#ffb4ab]\' : \'text-[#4fdbc8]\'\n              }`}\n            >\n              {analysis.heuristicsLabel}\n            </span>\n          </div>\n\n          <div className=\"flex flex-col items-center justify-center bg-[#141b2b] p-2 rounded-lg text-center border border-[#232a3a]/50\">\n            <span className=\"font-label-sm text-[9px] uppercase text-[#958ea0]\">Clone Match</span>\n            <span\n              className={`font-headline-sm text-sm font-bold mt-0.5 ${\n                analysis.verdict === \'malicious\' ? \'text-[#ff5451]\' : \'text-[#dce2f7]\'\n              }`}\n            >\n              {analysis.cloneMatchPercent}\n            </span>\n            <span\n              className={`font-label-sm text-[9px] ${\n                analysis.verdict === \'malicious\' ? \'text-[#ffb3ad]\' : \'text-[#4fdbc8]\'\n              }`}\n            >\n              {analysis.cloneMatchLabel}\n            </span>\n          </div>\n        </div>\n      </section>\n\n      {/* 4. DETECTION REASONS & SECURITY FINDINGS */}\n      <section className=\"flex flex-col gap-3\">\n        <div className=\"flex items-center justify-between px-1\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-[#d0bcff] text-[20px]\">policy</span>\n            <span className=\"font-label-md text-[11px] uppercase tracking-wider text-[#cbc3d7]\">\n              Core Security Findings\n            </span>\n          </div>\n          <span className=\"font-label-sm text-[10px] text-[#958ea0]\">\n            {analysis.findings.length} Triggers Discovered\n          </span>\n        </div>\n\n        <div className=\"flex flex-col gap-2\">\n          {analysis.findings.map((f) => {\n            const isCrit = f.severity === \'CRITICAL\' || f.severity === \'HIGH\';\n            const isWarn = f.severity === \'SUSPICIOUS\';\n            return (\n              <div\n                key={f.id}\n                className=\"flex items-start gap-3 p-3 rounded-xl bg-[#191f2f] border border-[#232a3a]/60 shadow-sm\"\n              >\n                <div\n                  className={`w-8 h-8 rounded-lg flex items-center justify-center shrink-0 mt-0.5 ${\n                    isCrit\n                      ? \'bg-[#93000a] text-[#ffb4ab]\'\n                      : isWarn\n                      ? \'bg-[#ff5451]/20 text-[#ffb3ad]\'\n                      : \'bg-[#4fdbc8]/20 text-[#4fdbc8]\'\n                  }`}\n                >\n                  <span className=\"material-symbols-outlined text-[18px]\">{f.icon}</span>\n                </div>\n                <div className=\"flex flex-col gap-1 min-w-0 flex-1\">\n                  <div className=\"flex items-center justify-between\">\n                    <span\n                      className={`font-headline-sm text-sm font-semibold truncate ${\n                        isCrit ? \'text-[#ffb4ab]\' : isWarn ? \'text-[#ffb3ad]\' : \'text-[#4fdbc8]\'\n                      }`}\n                    >\n                      {f.title}\n                    </span>\n                    <span\n                      className={`font-label-sm text-[9px] uppercase px-1.5 py-0.5 rounded font-bold ${\n                        isCrit\n                          ? \'bg-[#93000a] text-[#ffb4ab]\'\n                          : isWarn\n                          ? \'bg-[#ff5451]/20 text-[#ffb3ad]\'\n                          : \'bg-[#4fdbc8]/20 text-[#4fdbc8]\'\n                      }`}\n                    >\n                      {f.severity}\n                    </span>\n                  </div>\n                  <p className=\"font-body-sm text-xs text-[#cbc3d7] leading-relaxed\">\n                    {f.description}\n                  </p>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </section>\n\n      {/* 5. DEEP URL FEATURE ANALYSIS GRID */}\n      <section className=\"flex flex-col gap-3\">\n        <div className=\"flex items-center justify-between px-1\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-[#4fdbc8] text-[20px]\">hub</span>\n            <span className=\"font-label-md text-[11px] uppercase tracking-wider text-[#cbc3d7]\">\n              Deep URL Feature Matrix\n            </span>\n          </div>\n          <span className=\"font-label-sm text-[10px] text-[#4fdbc8] font-mono\">Telemetry Active</span>\n        </div>\n\n        <div className=\"grid grid-cols-2 gap-2\">\n          {analysis.features.map((feat) => {\n            const isAlert = feat.tagType === \'ALERT\' || feat.tagType === \'FLAG\' || feat.tagType === \'DECEPTIVE\';\n            return (\n              <div\n                key={feat.id}\n                className=\"flex flex-col p-3 rounded-xl bg-[#141b2b] gap-1 border border-[#232a3a]/60 shadow-sm\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"font-label-sm text-[9px] uppercase text-[#958ea0]\">{feat.label}</span>\n                  <span\n                    className={`font-label-sm text-[9px] px-1.5 py-0.5 rounded font-bold ${\n                      isAlert\n                        ? \'text-[#ffb4ab] bg-[#93000a]\'\n                        : feat.tagType === \'WARN\'\n                        ? \'text-[#ffb3ad] bg-[#ff5451]/20\'\n                        : \'text-[#4fdbc8] bg-[#4fdbc8]/15\'\n                    }`}\n                  >\n                    {feat.tag}\n                  </span>\n                </div>\n                <span\n                  className={`font-code-lg text-sm font-semibold ${\n                    isAlert ? \'text-[#ffb4ab]\' : \'text-[#dce2f7]\'\n                  }`}\n                >\n                  {feat.value}\n                </span>\n                <span className=\"font-body-sm text-[11px] text-[#cbc3d7] truncate\">{feat.description}</span>\n              </div>\n            );\n          })}\n        </div>\n      </section>\n\n      {/* 6. SSL & BRAND IMPERSONATION CHECK */}\n      <section className=\"flex flex-col bg-[#191f2f] rounded-xl p-4 gap-4 shadow-lg border border-[#232a3a]\">\n        {/* Target Brand Impersonation Spotlight */}\n        <div className=\"flex flex-col gap-2\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"material-symbols-outlined text-[#d0bcff] text-[20px]\">fingerprint</span>\n              <span className=\"font-label-md text-[11px] uppercase tracking-wider text-[#cbc3d7]\">\n                Brand Protection Matrix\n              </span>\n            </div>\n            <span\n              className={`font-label-sm text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-full font-bold ${\n                analysis.verdict === \'malicious\'\n                  ? \'text-[#ffb4ab] bg-[#93000a]\'\n                  : \'text-[#4fdbc8] bg-[#4fdbc8]/20\'\n              }`}\n            >\n              {analysis.verdict === \'malicious\' ? \'Critical Match\' : \'Legitimate Authority\'}\n            </span>\n          </div>\n\n          <div className=\"flex items-center justify-between bg-[#232a3a] p-3 rounded-xl border border-[#232a3a]\">\n            <div className=\"flex items-center gap-3 min-w-0\">\n              <div className=\"w-10 h-10 rounded-lg bg-[#070e1d] flex items-center justify-center text-[#d0bcff]\">\n                <span className=\"material-symbols-outlined text-[24px]\">account_balance</span>\n              </div>\n              <div className=\"flex flex-col min-w-0\">\n                <span className=\"font-headline-sm text-sm text-[#dce2f7] font-bold truncate\">\n                  {analysis.targetBrand || \'Generic Entity\'}\n                </span>\n                <span\n                  className={`font-label-sm text-[10px] ${\n                    analysis.verdict === \'malicious\' ? \'text-[#ffb4ab]\' : \'text-[#4fdbc8]\'\n                  }`}\n                >\n                  {analysis.verdict === \'malicious\' ? \'Typosquatting Target\' : \'Verified Entity\'}\n                </span>\n              </div>\n            </div>\n            <div className=\"flex flex-col items-end\">\n              <span\n                className={`font-headline-sm text-sm font-bold ${\n                  analysis.verdict === \'malicious\' ? \'text-[#ffb4ab]\' : \'text-[#4fdbc8]\'\n                }`}\n              >\n                {analysis.similarity || \'100%\'}\n              </span>\n              <span className=\"font-label-sm text-[9px] text-[#958ea0]\">Similarity</span>\n            </div>\n          </div>\n        </div>\n\n        {/* SSL Certificate Health Breakdown */}\n        <div className=\"flex flex-col gap-2\">\n          <span className=\"font-label-md text-[11px] uppercase tracking-wider text-[#cbc3d7]\">\n            TLS / SSL State Inspection\n          </span>\n          <div className=\"p-3 bg-[#141b2b] rounded-xl flex flex-col gap-1.5 border border-[#232a3a]\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <span\n                  className={`material-symbols-outlined text-[20px] ${\n                    analysis.verdict === \'malicious\' ? \'text-[#ffb3ad]\' : \'text-[#4fdbc8]\'\n                  }`}\n                >\n                  {analysis.verdict === \'malicious\' ? \'lock_open_right\' : \'lock\'}\n                </span>\n                <span className=\"font-headline-sm text-sm text-[#dce2f7] font-semibold\">\n                  {analysis.tlsState.title}\n                </span>\n              </div>\n              <span\n                className={`font-label-sm text-[9px] uppercase px-1.5 py-0.5 rounded font-bold ${\n                  analysis.verdict === \'malicious\'\n                    ? \'text-[#ffb3ad] bg-[#ff5451]/20\'\n                    : \'text-[#4fdbc8] bg-[#4fdbc8]/20\'\n                }`}\n              >\n                {analysis.tlsState.trustStatus}\n              </span>\n            </div>\n            <p className=\"font-body-sm text-xs text-[#cbc3d7] leading-relaxed\">\n              {analysis.tlsState.description}\n            </p>\n          </div>\n        </div>\n\n        {/* Remediation Tactical Buttons */}\n        <div className=\"flex flex-col gap-2 pt-1\">\n          <button\n            id=\"block-origin-btn\"\n            onClick={handleQuarantine}\n            className={`w-full h-12 flex items-center justify-center gap-2 font-label-md text-xs uppercase tracking-wider font-bold rounded-xl transition-all shadow-md active:scale-[0.98] ${\n              quarantined\n                ? \'bg-[#04b4a2] text-[#003f38] hover:bg-[#4fdbc8]\'\n                : \'bg-[#93000a] text-[#ffb4ab] hover:bg-[#ff5451] hover:text-white\'\n            }`}\n          >\n            <span className=\"material-symbols-outlined text-[20px]\">\n              {quarantined ? \'check_circle\' : \'block\'}\n            </span>\n            <span>\n              {quarantined ? \'Domain Quarantined & Blocked\' : \'Quarantine & Block Origin Domain\'}\n            </span>\n          </button>\n\n          <div className=\"flex gap-2\">\n            <button\n              id=\"export-ioc-btn\"\n              onClick={handleExportStix}\n              className=\"flex-1 h-10 flex items-center justify-center gap-1.5 bg-[#232a3a] hover:bg-[#323949] text-[#dce2f7] font-label-sm text-[10px] uppercase tracking-wider rounded-lg transition-colors border border-[#232a3a]\"\n            >\n              <span className=\"material-symbols-outlined text-[16px] text-[#4fdbc8]\">file_download</span>\n              <span>Export STIX IOC</span>\n            </button>\n\n            <button\n              id=\"telemetry-log-btn\"\n              onClick={() => setShowPacketDump(!showPacketDump)}\n              className=\"flex-1 h-10 flex items-center justify-center gap-1.5 bg-[#232a3a] hover:bg-[#323949] text-[#dce2f7] font-label-sm text-[10px] uppercase tracking-wider rounded-lg transition-colors border border-[#232a3a]\"\n            >\n              <span className=\"material-symbols-outlined text-[16px] text-[#d0bcff]\">terminal</span>\n      