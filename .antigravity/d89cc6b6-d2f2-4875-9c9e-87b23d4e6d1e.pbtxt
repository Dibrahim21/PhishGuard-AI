    content: "@import \"tailwindcss\";\n\n@theme {\n  --color-surface: #0c1322;\n  --color-surface-dim: #0c1322;\n  --color-surface-bright: #323949;\n  --color-surface-container-lowest: #070e1d;\n  --color-surface-container-low: #141b2b;\n  --color-surface-container: #191f2f;\n  --color-surface-container-high: #232a3a;\n  --color-surface-container-highest: #2e3545;\n  --color-surface-variant: #2e3545;\n  --color-on-surface: #dce2f7;\n  --color-on-surface-variant: #cbc3d7;\n  --color-inverse-surface: #dce2f7;\n  --color-inverse-on-surface: #293040;\n  --color-outline: #958ea0;\n  --color-outline-variant: #494454;\n  --color-surface-tint: #d0bcff;\n  --color-primary: #d0bcff;\n  --color-on-primary: #3c0091;\n  --color-primary-container: #a078ff;\n  --color-on-primary-container: #340080;\n  --color-inverse-primary: #6d3bd7;\n  --color-secondary: #4fdbc8;\n  --color-on-secondary: #003731;\n  --color-secondary-container: #04b4a2;\n  --color-on-secondary-container: #003f38;\n  --color-tertiary: #ffb3ad;\n  --color-on-tertiary: #68000a;\n  --color-tertiary-container: #ff5451;\n  --color-on-tertiary-container: #5c0008;\n  --color-error: #ffb4ab;\n  --color-on-error: #690005;\n  --color-error-container: #93000a;\n  --color-on-error-container: #ffdad6;\n  --color-primary-fixed: #e9ddff;\n  --color-primary-fixed-dim: #d0bcff;\n  --color-on-primary-fixed: #23005c;\n  --color-on-primary-fixed-variant: #5516be;\n  --color-secondary-fixed: #71f8e4;\n  --color-secondary-fixed-dim: #4fdbc8;\n  --color-on-secondary-fixed: #00201c;\n  --color-on-secondary-fixed-variant: #005048;\n  --color-tertiary-fixed: #ffdad7;\n  --color-tertiary-fixed-dim: #ffb3ad;\n  --color-on-tertiary-fixed: #410004;\n  --color-on-tertiary-fixed-variant: #930013;\n  --color-background: #0c1322;\n  --color-on-background: #dce2f7;\n\n  --font-headline-xl: \"Plus Jakarta Sans\", sans-serif;\n  --font-headline-lg: \"Plus Jakarta Sans\", sans-serif;\n  --font-headline-md: \"Plus Jakarta Sans\", sans-serif;\n  --font-headline-sm: \"Plus Jakarta Sans\", sans-serif;\n  --font-body-lg: \"Inter\", sans-serif;\n  --font-body-md: \"Inter\", sans-serif;\n  --font-body-sm: \"Inter\", sans-serif;\n  --font-code-lg: \"JetBrains Mono\", monospace;\n  --font-code-md: \"JetBrains Mono\", monospace;\n  --font-label-md: \"JetBrains Mono\", monospace;\n  --font-label-sm: \"JetBrains Mono\", monospace;\n\n  --spacing-space-2xs: 0.25rem;\n  --spacing-space-xs: 0.5rem;\n  --spacing-space-sm: 0.75rem;\n  --spacing-space-md: 1rem;\n  --spacing-space-lg: 1.5rem;\n  --spacing-space-xl: 2rem;\n  --spacing-space-2xl: 3rem;\n  --spacing-space-3xl: 4rem;\n}\n\n@layer base {\n  html, body {\n    width: 100%;\n    margin: 0;\n    padding: 0;\n    background-color: #0c1322;\n    color: #dce2f7;\n    font-family: \"Inter\", sans-serif;\n    overscroll-behavior: none;\n  }\n\n  .pb-safe {\n    padding-bottom: env(safe-area-inset-bottom, 0px);\n  }\n  .pt-safe {\n    padding-top: env(safe-area-inset-top, 0px);\n  }\n}\n\n/* Custom utility classes */\n.font-headline-xl { font-family: \"Plus Jakarta Sans\", sans-serif; font-size: 36px; line-height: 44px; letter-spacing: -0.025em; font-weight: 700; }\n.font-headline-xl-mobile { font-family: \"Plus Jakarta Sans\", sans-serif; font-size: 26px; line-height: 34px; letter-spacing: -0.02em; font-weight: 700; }\n.font-headline-lg { font-family: \"Plus Jakarta Sans\", sans-serif; font-size: 28px; line-height: 36px; letter-spacing: -0.02em; font-weight: 600; }\n.font-headline-lg-mobile { font-family: \"Plus Jakarta Sans\", sans-serif; font-size: 24px; line-height: 32px; letter-spacing: -0.02em; font-weight: 700; }\n.font-headline-md { font-family: \"Plus Jakarta Sans\", sans-serif; font-size: 20px; line-height: 28px; letter-spacing: -0.015em; font-weight: 600; }\n.font-headline-sm { font-family: \"Plus Jakarta Sans\", sans-serif; font-size: 16px; line-height: 24px; letter-spacing: -0.01em; font-weight: 600; }\n\n.font-body-lg { font-family: \"Inter\", sans-serif; font-si