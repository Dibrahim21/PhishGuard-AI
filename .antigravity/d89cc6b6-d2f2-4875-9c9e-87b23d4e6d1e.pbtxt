darClusterActive: boolean;\n  homoglyphDetection: boolean;\n  neuralOcrScan: boolean;\n  autoSinkhole: boolean;\n  zeroDayTelemetry: boolean;\n  activeRegions: number;\n  feeds: {\n    alienVault: boolean;\n    virusTotal: boolean;\n    phishTank: boolean;\n    cisaKnown: boolean;\n  };\n  webhooks: {\n    slack: boolean;\n    splunk: boolean;\n    sentinel: boolean;\n    pagerduty: boolean;\n  };\n}\n"
