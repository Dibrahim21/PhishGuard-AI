      <span className=\\\"text-purple-400 font-mono font-bold\\\">100% BLOCKED</span>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* AI-Powered Protection Section (Violet/Purple AI Accent) */}\\n      <div className=\\\"rounded-2xl bg-gradient-to-r from-purple-950/30 via-[#161324] to-[#12141c] border border-purple-500/30 p-5 sm:p-6 shadow-xl relative overflow-hidden space-y-4\\\">\\n        <div className=\\\"absolute right-0 top-0 w-72 h-72 bg-purple-600/15 rounded-full blur-3xl pointer-events-none\\\" />\\n\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <div className=\\\"w-10 h-10 rounded-xl bg-purple-500/20 border border-purple-500/40 flex items-center justify-center text-purple-300 shadow-[0_0_16px_rgba(168,85,247,0.25)]\\\">\\n              <Bot className=\\\"w-5 h-5\\\" />\\n            </div>\\n            <div>\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <h2 className=\\\"text-lg font-bold text-white\\\">Sentinel AI-Powered Threat Protection</h2>\\n                <span className=\\\"text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30\\\">\\n                  NEURAL OCR & HEURISTICS\\n                </span>\\n              </div>\\n              <p className=\\\"text-xs text-zinc-400\\\">\\n                Continuous generative neural scanning inspecting visual brand likeness, DOM reverse-proxies, and prompt injection attempts.\\n              </p>\\n            </div>\\n          </div>\\n\\n          <button\\n            onClick={onNavigateToChatbot}\\n            className=\\\"px-4 py-2 rounded-xl bg-purple-600/20 hover:bg-purple-600/30 text-purple-200 border border-purple-500/40 text-xs font-bold flex items-center gap-2 transition-all shrink-0 cursor-pointer\\\"\\n          >\\n         