    content: "import { NavTab } from \'../types\';\n\ninterface BottomNavProps {\n  currentTab: NavTab;\n  onTabChange: (tab: NavTab) => void;\n}\n\nexport default function BottomNav({ currentTab, onTabChange }: BottomNavProps) {\n  const tabs: { id: NavTab; label: string; icon: string; path: string }[] = [\n    { id: \'soc\', label: \'SOC\', icon: \'shield\', path: \'soc-command-center\' },\n    { id: \'scan\', label: \'Scan\', icon: \'radar\', path: \'neural-url-scanner\' },\n    { id: \'logs\', label: \'Logs\', icon: \'history\', path: \'telemetry-history\' },\n    { id: \'sentinel\', label: \'Sentinel\', icon: \'smart_toy\', path: \'sentinel-ai-assistant\' },\n    { id: \'config\', label: \'Config\', icon: \'tune\', path: \'heuristics-and-settings\' },\n  ];\n\n  return (\n    <nav\n      className=\"fixed bottom-0 inset-x-0 z-50 pb-safe bg-[#070e1d]/85 backdrop-blur-xl shadow-[0_-4px_20px_rgba(0,0,0,0.5)] border-t border-[#232a3a]/40\"\n      aria-label=\"Bottom Navigation\"\n    >\n      <div className=\"flex justify-around items-center h-16 px-1 max-w-md mx-auto\">\n        {tabs.map((tab) => {\n          const isActive = currentTab === tab.id;\n          return (\n            <button\n              key={tab.id}\n              onClick={() => onTabChange(tab.id)}\n              aria-current={isActive ? \'page\' : undefined}\n              data-path={tab.path}\n              className={`flex flex-col items-center justify-center min-w-[56px] h-12 rounded-xl gap-0.5 transition-all ${\n                isActive\n                  ? \'text-[#d0bcff] bg-[#a078ff]/10 font-semibold shadow-[0_0_12px_rgba(160,120,255,0.15)]\'\n                  : \'text-[#cbc3d7] hover:text-[#dce2f7] active:bg-[#191f2f]\'\n              }`}\n            >\n              <span\n                className=\"material-symbols-outlined text-[22px]\"\n                style={isActive ? { fontVariationSettings: \"\'FILL\' 1\" } : undefined}\n              >\n                {tab.icon}\n              </span>\n              <span className=\"font-label-sm text-[10px] tracking-wide\">\n                {tab.label}\n              </span>\n            </button>\n          );\n        })}\n      </div>\n    </nav>\n  );\n}\n"
    raw_content: "import { NavTab } from \'../types\';\n\ninterface BottomNavProps {\n  currentTab: NavTab;\n  onTabChange: (tab: NavTab) => void;\n}\n\nexport default function BottomNav({ currentTab, onTabChange }: BottomNavProps) {\n  const tabs: { id: NavTab; label: string; icon: string; path: string }[] = [\n    { id: \'soc\', label: \'SOC\', icon: \'shield\', path: \'soc-command-center\' },\n    { id: \'scan\', label: \'Scan\', icon: \'radar\', path: \'neural-url-scanner\' },\n    { id: \'logs\', label: \'Logs\', icon: \'history\', path: \'telemetry-history\' },\n    { id: \'sentinel\', label: \'Sentinel\', icon: \'smart_toy\', path: \'sentinel-ai-assistant\' },\n    { id: \'config\', label: \'Config\', icon: \'tune\', path: \'heuristics-and-settings\' },\n  ];\n\n  return (\n    <nav\n      className=\"fixed bottom-0 inset-x-0 z-50 pb-safe bg-[#070e1d]/85 backdrop-blur-xl shadow-[0_-4px_20px_rgba(0,0,0,0.5)] border-t border-[#232a3a]/40\"\n      aria-label=\"Bottom Navigation\"\n    >\n      <div className=\"flex justify-around items-center h-16 px-1 max-w-md mx-auto\">\n        {tabs.map((tab) => {\n          const isActive = currentTab === tab.id;\n          return (\n            <button\n              key={tab.id}\n              onClick={() => onTabChange(tab.id)}\n              aria-current={isActive ? \'page\' : undefined}\n              data-path={tab.path}\n              className={`flex flex-col items-center justify-center min-w-[56px] h-12 rounded-xl gap-0.5 transition-all ${\n                isActive\n                  ? \'text-[#d0bcff] bg-[#a078ff]/10 font-semibold shadow-[0_0_12px_rgba(160,120,255,0.15)]\'\n                  : \'text-[#cbc3d7] hover:text-[#dce2f7] active:bg-[#191f2f]\'\n              }`}\n            >\n              <span\n                className=\"material-symbols-outlined text-[22px]\"\n                style={isActive ? { fontVariationSettings: \"\'FILL\' 1\" } : undefined}\n              >\n                {tab.icon}\n              </span>\n              <span className=\"font-label-sm text-[10px] tracking-wide\">\n                {tab.label}\n              </span>\n            </button>\n          );\n        })}\n      </div>\n    </nav>\n  );\n}\n"
