    replacement_chunks {
      replacement_content: "import { useState } from \'react\';\nimport { NavTab } from \'../types\';\n\ninterface HeaderProps {\n  currentTab: NavTab;\n  onTabChange: (tab: NavTab) => void;\n  radarActive: boolean;\n  onToggleRadar: () => void;\n}\n\nexport default function Header({ currentTab, onTabChange, radarActive, onToggleRadar }: HeaderProps) {\n  const [drawerOpen, setDrawerOpen] = useState(false);\n\n  const getSubTitle = () => {\n    switch (currentTab) {\n      case \'soc\': return \'SOC COMMAND CENTER\';\n      case \'scan\': return \'NEURAL URL SCANNER\';\n      case \'logs\': return \'TELEMETRY HISTORY\';\n      case \'sentinel\': return \'SENTINEL AI ASSISTANT\';\n      case \'config\': return \'SOC CONFIGURATION\';\n    }\n  };\n\n  return (\n    <>\n      <header className=\"fixed top-0 inset-x-0 z-50 bg-[#070e1d]/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.5)] pt-safe border-b border-[#232a3a]/50\">\n        <div className=\"h-16 px-4 flex items-center justify-between max-w-4xl mx-auto\">\n          {/* Left: Menu & Brand Logo */}\n          <div className=\"flex items-center gap-3\">\n            <button\n              aria-label=\"Open Command Menu\"\n              onClick={() => setDrawerOpen(true)}\n              className=\"w-11 h-11 flex items-center justify-center text-[#cbc3d7] hover:text-[#4fdbc8] rounded-lg active:bg-[#232a3a] transition-colors\"\n            >\n              <span className=\"material-symbols-outlined text-[24px]\">menu</span>\n            </button>\n            <div\n              className=\"flex items-center gap-2 cursor-pointer select-none\"\n              onClick={() => onTabChange(\'soc\')}\n            >\n              <img\n                alt=\"PhishGuard AI Logo\"\n                className=\"h-8 w-auto object-contain\"\n                src=\"https://lh3.googleusercontent.com/aida/AEtjO1Xs7RmEqun3RkiIt0Wl_ycMOyzVqHnzAP7pA2vB9fm5Cqu5izC88okvuZ1IRTtjc_sCo-row13zX6D5CO4QQetE2fI1AA8Ty525R0V7CN9XLDFqPz1QE3TV7BVpdzYfW3dhL_R9TTYFzcTa0THzqdVsS38BZzimOE-_mFt5KpU6oAdDoZRIOZo0se7FiQFSIqUaN1qbJKUSK2pn50r9fl3y5o1QkEk2aznlypUAJVg5d9Zo381IUtB6nmrJ\"\n              />\n              <div className=\"flex flex-col\">\n                <span className=\"font-headline-sm text-[17px] font-bold tracking-tight text-[#dce2f7]\">\n                  PhishGuard\n                </span>\n                <span className=\"font-label-sm text-[10px] uppercase tracking-widest text-[#d0bcff] font-semibold\">\n                  {getSubTitle()}\n                </span>\n              </div>\n            </div>\n          </div>\n\n          {/* Right: Radar Badge & Profile */}\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={onToggleRadar}\n              className={`flex items-center gap-1.5 px-2.5 py-1 rounded-full shadow-sm transition-all active:scale-95 ${\n                radarActive\n                  ? \'bg-[#141b2b]/90 text-[#4fdbc8] shadow-[0_0_12px_-2px_rgba(79,219,200,0.3)]\'\n                  : \'bg-[#191f2f] text-[#958ea0]\'\n              }`}\n            >\n              <span\n                className={`w-2 h-2 rounded-full ${\n                  radarActive ? \'bg-[#4fdbc8] animate-pulse\' : \'bg-[#494454]\'\n                }`}\n              />\n              <span className=\"font-label-sm text-[10px] uppercase font-semibold tracking-wider\">\n                {radarActive ? \'RADAR ON\' : \'STANDBY\'}\n              </span>\n            </button>\n\n            <button\n              aria-label=\"User Profile\"\n              onClick={() => onTabChange(\'config\')}\n              className=\"w-10 h-10 flex items-center justify-center rounded-full active:opacity-80 transition-opacity ring-1 ring-[#494454]/40\"\n            >\n              <img\n                alt=\"Profile\"\n                className=\"w-8 h-8 rounded-full object-cover\"\n                src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBNSv6oaHv0MziUPe8MVIS_tsNFP_7UlGT9eJF5gQ3eiYqc_qx-AhCyzf1SpkhgCfvN5_nbyv_DWRvbWiDsy8IlKCfoPB-LMuYN1yT3AaHX8nuGwoySiPpJd9lFdyx-zjp1ABUCv8HhLUn36sBoXXBu6HgXY0p6luiXXXhOXGig1x-sRFbFngm1w8fvaqNDh_j3KttMqgy1eRFI6QPi3_XAZHazfHkVq8hcGA7nzOoSwXxZG0xuW62oqA\"\n              />\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Slide-out Navigation Drawer for quick links */}\n      {drawerOpen && (\n        <div className=\"fixed inset-0 z-50 flex\">\n          <div\n            className=\"fixed inset-0 bg-black/70 backdrop-blur-sm transition-opacity\"\n            onClick={() => setDrawerOpen(false)}\n          />\n          <div className=\"relative w-72 max-w-[85vw] bg-[#0c1322] border-r border-[#232a3a] h-full flex flex-col p-5 shadow-2xl z-10\">\n            <div className=\"flex items-center justify-between pb-4 border-b border-[#232a3a]\">\n              <div className=\"flex items-center gap-2\">\n                <img\n                  alt=\"Logo\"\n                  className=\"h-7 w-auto\"\n                  src=\"https://lh3.googleusercontent.com/aida/AEtjO1Xs7RmEqun3RkiIt0Wl_ycMOyzVqHnzAP7pA2vB9fm5Cqu5izC88okvuZ1IRTtjc_sCo-row13zX6D5CO4QQetE2fI1AA8Ty525R0V7CN9XLDFqPz1QE3TV7BVpdzYfW3dhL_R9TTYFzcTa0THzqdVsS38BZzimOE-_mFt5KpU6oAdDoZRIOZo0se7FiQFSIqUaN1qbJKUSK2pn50r9fl3y5o1QkEk2aznlypUAJVg5d9Zo381IUtB6nmrJ\"\n                />\n                <span className=\"font-headline-sm text-[16px] font-bold text-[#dce2f7]\">\n                  PhishGuard SOC\n                </span>\n              </div>\n              <button\n                onClick={() => setDrawerOpen(false)}\n                className=\"w-8 h-8 flex items-center justify-center rounded-lg bg-[#191f2f] text-[#cbc3d7]\"\n              >\n                <span className=\"material-symbols-outlined text-[18px]\">close</span>\n              </button>\n            </div>\n\n            <div className=\"my-4 p-3 rounded-xl bg-[#141b2b] border border-[#232a3a]\">\n              <div className=\"flex items-center justify-between text-xs text-[#958ea0] mb-1\">\n                <span>SURVEILLANCE CLUSTER</span>\n                <span className=\"text-[#4fdbc8] font-bold\">ONLINE</span>\n              </div>\n              <div className=\"text-sm font-semibold text-[#dce2f7]\">Surveillance Node #4</div>\n              <div className=\"text-[11px] text-[#cbc3d7]/70 font-mono mt-0.5\">Latency: 14ms \342\200\242 6 Regions Active</div>\n            </div>\n\n            <div className=\"flex flex-col space-y-1.5 flex-1\">\n              {[\n                { id: \'soc\', label: \'SOC Command Center\', icon: \'shield\', desc: \'Main telemetry dashboard\' },\n                { id: \'scan\', label: \'Neural URL Scanner\', icon: \'radar\', desc: \'Real-time deep heuristic inspection\' },\n                { id: \'logs\', label: \'Telemetry History\', icon: \'history\', desc: \'Scan audit logs & forensics\' },\n                { id: \'sentinel\', label: \'Sentinel AI Assistant\', icon: \'smart_toy\', desc: \'Conversational threat advisor\' },\n                { id: \'config\', label: \'Engine Configuration\', icon: \'tune\', desc: \'Heuristics, feeds & webhooks\' },\n              ].map((item) => (\n                <button\n                  key={item.id}\n                  onClick={() => {\n                    onTabChange(item.id as NavTab);\n                    setDrawerOpen(false);\n                  }}\n                  className={`flex items-start gap-3 p-3 rounded-xl text-left transition-all ${\n                    currentTab === item.id\n                      ? \'bg-[#a078ff]/15 text-[#d0bcff] border border-[#a078ff]/30\'\n                      : \'hover:bg-[#191f2f] text-[#cbc3d7]\'\n                  }`}\n                >\n                  <span className=\"material-symbols-outlined text-[20px] mt-0.5\">{item.icon}</span>\n                  <div>\n                    <div className=\"text-sm font-semibold\">{item.label}</div>\n                    <div className=\"text-[11px] text-[#958ea0]\">{item.desc}</div>\n                  </div>\n                </button>\n              ))}\n            </div>\n\n            <div className=\"pt-4 border-t border-[#232a3a] text-center text-[10px] text-[#958ea0] font-mono\">\n              PHISHGUARD AUTONOMOUS ENGINE v4.8.2\n            </div>\n          </div>\n        </div>\n      )}\n    </>\n  );\n}\n"
    }
