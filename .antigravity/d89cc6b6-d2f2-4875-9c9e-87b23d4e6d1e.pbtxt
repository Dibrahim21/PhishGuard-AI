erif;\n  --font-headline-sm: \"Plus Jakarta Sans\", sans-serif;\n  --font-body-lg: \"Inter\", sans-serif;\n  --font-body-md: \"Inter\", sans-serif;\n  --font-body-sm: \"Inter\", sans-serif;\n  --font-code-lg: \"JetBrains Mono\", monospace;\n  --font-code-md: \"JetBrains Mono\", monospace;\n  --font-label-md: \"JetBrains Mono\", monospace;\n  --font-label-sm: \"JetBrains Mono\", monospace;\n\n  --spacing-space-2xs: 0.25rem;\n  --spacing-space-xs: 0.5rem;\n  --spacing-space-sm: 0.75rem;\n  --spacing-space-md: 1rem;\n  --spacing-space-lg: 1.5rem;\n  --spacing-space-xl: 2rem;\n  --spacing-space-2xl: 3rem;\n  --spacing-space-3xl: 4rem;\n}\n\n@layer base {\n  html, body {\n    width: 100%;\n    margin: 0;\n    padding: 0;\n    background-color: #0c1322;\n    color: #dce2f7;\n    font-family: \"Inter\", sans-serif;\n    overscroll-behavior: none;\n  }\n\n  .pb-safe {\n    padding-bottom: env(safe-area-inset-bottom, 0px);\n  }\n  .pt-safe {\n    padding-top: env(safe-area-inset-top, 0px);\n  }\n}\n\n/* Custom utility classes */\n.font-headline-xl { font-family: \"Plus Jakarta Sans\", sans-serif; font-size: 36px; line-height: 44px; letter-spacing: -0.025em; font-weight: 700; }\n.font-headline-xl-mobile { font-family: \"Plus Jakarta Sans\", sans-serif; font-size: 26px; line-height: 34px; letter-spacing: -0.02em; font-weight: 700; }\n.font-headline-lg { font-family: \"Plus Jakarta Sans\", sans-serif; font-size: 28px; line-height: 36px; letter-spacing: -0.02em; font-weight: 600; }\n.font-headline-lg-mobile { font-family: \"Plus Jakarta Sans\", sans-serif; font-size: 24px; line-height: 32px; letter-spacing: -0.02em; font-weight: 700; }\n.font-headline-md { font-family: \"Plus Jakarta Sans\", sans-serif; font-size: 20px; line-height: 28px; letter-spacing: -0.015em; font-weight: 600; }\n.font-headline-sm { font-family: \"Plus Jakarta Sans\", sans-serif; font-size: 16px; line-height: 24px; letter-spacing: -0.01em; font-weight: 600; }\n\n.font-body-lg { font-family: \"Inter\", sans-serif; font-size: 16px; line-height: 26px; letter-spacing: -0.005em; font-weight: 400; }\n.font-body-md { font-family: \"Inter\", sans-serif; font-size: 14px; line-height: 22px; letter-spacing: 0em; font-weight: 400; }\n.font-body-sm { font-family: \"Inter\", sans-serif; font-size: 12px; line-height: 18px; letter-spacing: 0.01em; font-weight: 400; }\n\n.font-code-lg { font-family: \"JetBrains Mono\", monospace; font-size: 15px; line-height: 22px; letter-spacing: -0.02em; font-weight: 500; }\n.font-code-md { font-family: \"JetBrains Mono\", monospace; font-size: 13px; line-height: 18px; letter-spacing: -0.01em; font-weight: 500; }\n.font-label-md { font-family: \"JetBrains Mono\", monospace; font-size: 11px; line-height: 14px; letter-spacing: 0.08em; font-weight: 600; }\n.font-label-sm { font-family: \"JetBrains Mono\", monospace; font-size: 10px; line-height: 12px; letter-spacing: 0.1em; font-weight: 600; }\n\n.text-headline-xl { font-size: 36px; line-height: 44px; letter-spacing: -0.025em; }\n.text-headline-xl-mobile { font-size: 26px; line-height: 34px; letter-spacing: -0.02em; }\n.text-headline-lg { font-size: 28px; line-height: 36px; letter-spacing: -0.02em; }\n.text-headline-lg-mobile { font-size: 24px; line-height: 32px; letter-spacing: -0.02em; }\n.text-headline-md { font-size: 20px; line-height: 28px; letter-spacing: -0.015em; }\n.text-headline-sm { font-size: 16px; line-height: 24px; letter-spacing: -0.01em; }\n.text-body-lg { font-size: 16px; line-height: 26px; }\n.text-body-md { font-size: 14px; line-height: 22px; }\n.text-body-sm { font-size: 12px; line-height: 18px; }\n.text-code-lg { font-size: 15px; line-height: 22px; }\n.text-code-md { font-size: 13px; line-height: 18px; }\n.text-label-md { font-size: 11px; line-height: 14px; letter-spacing: 0.08em; }\n.text-label-sm { font-size: 10px; line-height: 12px; letter-spacing: 0.1em; }\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n::-webkit-scrollbar-thumb {\n  background: rgba(149, 142, 160, 0.2);\n  border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: rgba(149, 142, 160, 0.4);\n}\n.scrollbar-none::-webkit-scrollbar,\n.no-scrollbar::-webkit-scrollbar {\n  display: none;\n}\n.scrollbar-none,\n.no-scrollbar {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n"
