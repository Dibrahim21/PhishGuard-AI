    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState } from \'react\';\nimport { PlaybookModule } from \'../types\';\nimport { PLAYBOOK_MODULES } from \'../data/mockData\';\n\ninterface SocCommandCenterProps {\n  onScanUrl: (url: string) => void;\n  onOpenPlaybook: (playbook: PlaybookModule) => void;\n}\n\nexport default function SocCommandCenter({ onScanUrl, onOpenPlaybook }: SocCommandCenterProps) {\n  const [quickScanOpen, setQuickScanOpen] = useState(false);\n  const [quickInputUrl, setQuickInputUrl] = useState(\'\');\n  const [isScanning, setIsScanning] = useState(false);\n  const [scanResult, setScanResult] = useState<string | null>(null);\n\n  const handleQuickScan = () => {\n    const val = quickScanOpen ? quickInputUrl.trim() : \'\';\n    if (!val) {\n      setQuickScanOpen(true);\n      return;\n    }\n    setIsScanning(true);\n    setScanResult(null);\n\n    setTimeout(() => {\n      setIsScanning(false);\n      setScanResult(\'Diagnostic complete. Forwarding to Neural URL Scanner...\');\n      setTimeout(() => {\n        onScanUrl(val);\n      }, 600);\n    }, 900);\n  };\n\n  const feedItems = [\n    {\n      domain: \'paypal-security-update-login.top\',\n      fullUrl: \'https://paypal-security-update-login.top/signin\',\n      status: \'BLOCKED\',\n      statusClass: \'bg-[#93000a] text-[#ffdad6]\',\n      score: \'98/100\',\n      scoreClass: \'bg-[#93000a] text-[#ffdad6] shadow-[0_0_8px_rgba(255,84,81,0.3)]\',\n      payload: \'Payload: Phishing Login Clone\',\n      time: \'1m ago\',\n    },\n    {\n      domain: \'auth-microsoft365-verify.cc\',\n      fullUrl: \'https://auth-microsoft365-verify.cc/login\',\n      status: \'BLOCKED\',\n      statusClass: \'bg-[#93000a] text-[#ffdad6]\',\n      score: \'94/100\',\n      scoreClass: \'bg-[#93000a] text-[#ffdad6] shadow-[0_0_8px_rgba(255,84,81,0.3)]\',\n      payload: \'Payload: Credential Harvester\',\n      time: \'4m ago\',\n    },\n    {\n      domain: \'github-status.org\',\n      fullUrl: \'https://github-status.org\',\n      status: \'FLAGGED\',\n      statusClass: \'bg-[#2e3545] text-[#ffb3ad]\',\n      score: \'68/100\',\n      scoreClass: \'bg-[#2e3545] text-[#ffb3ad]\',\n      payload: \'Heuristic: Typosquat Divergence\',\n      time: \'12m ago\',\n    },\n    {\n      domain: \'stripe.com/billing\',\n      fullUrl: \'https://stripe.com/billing\',\n      status: \'CLEAN\',\n      statusClass: \'bg-[#2e3545] text-[#4fdbc8]\',\n      score: \'4/100\',\n      scoreClass: \'bg-[#4fdbc8]/15 text-[#4fdbc8]\',\n      payload: \'Status: Valid TLS 1.3 + EV Certificate\',\n      time: \'18m ago\',\n    },\n  ];\n\n  return (\n    <div className=\"flex flex-col w-full max-w-lg mx-auto px-4 py-3 space-y-4\">\n      {/* Autonomous Engine Live Status Banner */}\n      <div className=\"relative overflow-hidden rounded-xl bg-[#141b2b] p-4 shadow-lg border border-[#232a3a]/60\">\n        <div className=\"absolute -right-8 -bottom-8 w-36 h-36 bg-[#d0bcff]/10 rounded-full blur-3xl pointer-events-none\" />\n        <div className=\"flex items-center justify-between gap-2\">\n          <div className=\"flex items-center gap-2 min-w-0\">\n            <div className=\"relative flex items-center justify-center w-10 h-10 rounded-xl bg-[#d0bcff]/15 text-[#d0bcff] shrink-0 shadow-[0_0_16px_rgba(208,188,255,0.25)]\">\n              <span className=\"material-symbols-outlined text-[20px]\" style={{ fontVariationSettings: \"\'FILL\' 1\" }}>\n                security\n              </span>\n              <span className=\"absolute top-1 right-1 w-2 h-2 rounded-full bg-[#4fdbc8] animate-ping\" />\n            </div>\n            <div className=\"flex flex-col min-w-0\">\n              <div className=\"flex items-center gap-1.5\">\n                <span className=\"font-headline-sm text-sm sm:text-base text-[#dce2f7] truncate\">Threat Engine v4.8</span>\n                <span className=\"inline-flex items-center px-1.5 py-0.5 rounded-full bg-[#4fdbc8]/15 text-[#4fdbc8] font-label-sm text-[10px]\">\n                  LIVE\n                </span>\n              </div>\n              <span className=\"font-body-sm text-[12px] text-[#cbc3d7] truncate\">\n                Neural Heuristic Core: Latency 14ms\n              </span>\n            </div>\n          </div>\n          <button\n            id=\"scanQuickTrigger\"\n            onClick={() => setQuickScanOpen(!quickScanOpen)}\n            className=\"shrink-0 flex items-center gap-1 px-3 py-2 rounded-xl bg-[#a078ff] hover:bg-[#a078ff]/90 text-[#340080] font-headline-sm text-xs font-bold shadow-[0_0_20px_rgba(160,120,255,0.35)] active:scale-95 transition-all\"\n          >\n            <span className=\"material-symbols-outlined text-[18px]\">add_link</span>\n            <span>Scan URL</span>\n          </button>\n        </div>\n\n        {/* Live Pulse Mini Strip */}\n        <div className=\"mt-3 pt-2 border-t border-[#232a3a]/40 flex items-center justify-between text-[#cbc3d7] font-label-sm text-[10px]\">\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-[#4fdbc8]\" />\n            <span>RADAR CLUSTER: 6 REGIONS ACTIVE</span>\n          </div>\n          <span className=\"text-[#4fdbc8] font-semibold\">99.98% ACCURACY</span>\n        </div>\n      </div>\n\n      {/* Interactive URL Ingestion Modal Drawer */}\n      {quickScanOpen && (\n        <div className=\"rounded-xl bg-[#232a3a] p-4 space-y-3 shadow-2xl border border-[#a078ff]/30 animate-fadeIn\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"material-symbols-outlined text-[#d0bcff] text-[20px]\">radar</span>\n              <span className=\"font-headline-sm text-sm text-[#dce2f7]\">Neural URL Diagnostic</span>\n            </div>\n            <button\n              onClick={() => setQuickScanOpen(false)}\n              className=\"w-7 h-7 rounded-lg bg-[#191f2f] hover:bg-[#141b2b] flex items-center justify-center text-[#cbc3d7]\"\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">close</span>\n            </button>\n          </div>\n\n          <div className=\"relative flex items-center\">\n            <input\n              type=\"text\"\n              id=\"targetUrlInput\"\n              value={quickInputUrl}\n              onChange={(e) => setQuickInputUrl(e.target.value)}\n              onKeyDown={(e) => e.key === \'Enter\' && handleQuickScan()}\n              placeholder=\"https://domain-to-inspect.com/login\"\n              className=\"w-full h-11 pl-3 pr-24 rounded-lg bg-[#070e1d] text-[#dce2f7] font-code-md text-xs placeholder:text-[#958ea0] focus:outline-none focus:ring-1 focus:ring-[#a078ff] shadow-inner border border-[#494454]/40\"\n            />\n            <button\n              id=\"executeScanBtn\"\n              disabled={isScanning}\n              onClick={handleQuickScan}\n              className=\"absolute right-1 px-3 py-1.5 rounded-lg bg-[#d0bcff] text-[#3c0091] font-label-sm text-[10px] uppercase font-bold hover:bg-white transition-all disabled:opacity-50\"\n            >\n              {isScanning ? \'Analyzing...\' : \'Analyze\'}\n            </button>\n          </div>\n\n          {/* Preset test buttons */}\n          <div className=\"flex flex-wrap gap-1.5 text-[10px] font-mono\">\n            <span className=\"text-[#958ea0] py-0.5\">Quick targets:</span>\n            {[\n              \'wellsfarg0-verify.com/auth\',\n              \'login-apple-icloud-security.net\',\n              \'stripe.com/billing\',\n            ].map((target) => (\n              <button\n                key={target}\n                onClick={() => {\n                  setQuickInputUrl(\'https://\' + target);\n                }}\n                className=\"px-2 py-0.5 rounded bg-[#191f2f] hover:bg-[#141b2b] text-[#4fdbc8] border border-[#232a3a]\"\n              >\n                {target.split(\'/\')[0]}\n              </button>\n            ))}\n          </div>\n\n          {isScanning && (\n            <div className=\"rounded-lg bg-[#141b2b] p-2 text-xs font-body-sm text-[#cbc3d7] flex items-center gap-2 border border-[#232a3a]\">\n              <span className=\"material-symbols-outlined text-[#4fdbc8] text-[18px] animate-spin\">sync</span>\n              <span>Simulating synthetic headless browser render & OCR clone scan...</span>\n            </div>\n          )}\n\n          {scanResult && (\n            <div className=\"rounded-lg bg-[#141b2b] p-2 text-xs font-body-sm text-[#4fdbc8] flex items-center gap-2 border border-[#4fdbc8]/30\">\n              <span className=\"material-symbols-outlined text-[18px]\">verified</span>\n              <span>{scanResult}</span>\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* Top KPI Metrics Cards (2x2 Grid) */}\n      <div className=\"grid grid-cols-2 gap-2\">\n        {/* Card 1: Total Scans */}\n        <div className=\"relative overflow-hidden rounded-xl bg-[#191f2f] p-3 shadow-md border border-[#232a3a]/50\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"font-label-sm text-[10px] text-[#cbc3d7] uppercase tracking-wider\">Total Scans</span>\n            <div className=\"w-6 h-6 rounded-lg bg-[#232a3a] flex items-center justify-center text-[#4fdbc8]\">\n              <span className=\"material-symbols-outlined text-[16px]\">troubleshoot</span>\n            </div>\n          </div>\n          <div className=\"mt-1 flex flex-col\">\n            <span className=\"font-headline-lg-mobile text-[22px] font-bold text-[#dce2f7] tracking-tight\">\n              14,892\n            </span>\n            <div className=\"mt-0.5 inline-flex items-center gap-1 text-[#4fdbc8] font-label-sm text-[10px]\">\n              <span className=\"material-symbols-outlined text-[14px]\">trending_up</span>\n              <span>+18.4% 7d</span>\n            </div>\n          </div>\n          <div className=\"absolute bottom-0 inset-x-0 h-0.5 bg-gradient-to-r from-[#4fdbc8]/40 via-[#4fdbc8] to-transparent\" />\n        </div>\n\n        {/* Card 2: Safe Websites */}\n        <div className=\"relative overflow-hidden rounded-xl bg-[#191f2f] p-3 shadow-md border border-[#232a3a]/50\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"font-label-sm text-[10px] text-[#cbc3d7] uppercase tracking-wider\">Verified Safe</span>\n            <div className=\"w-6 h-6 rounded-lg bg-[#232a3a] flex items-center justify-center text-[#04b4a2]\">\n              <span className=\"material-symbols-outlined text-[16px]\">verified_user</span>\n            </div>\n          </div>\n          <div className=\"mt-1 flex flex-col\">\n            <span className=\"font-headline-lg-mobile text-[22px] font-bold text-[#dce2f7] tracking-tight\">\n              12,410\n            </span>\n            <div className=\"mt-0.5 inline-flex items-center gap-1 text-[#4fdbc8] font-label-sm text-[10px]\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-[#4fdbc8]\" />\n              <span>83.3% safe</span>\n            </div>\n          </div>\n          <div className=\"absolute bottom-0 inset-x-0 h-0.5 bg-gradient-to-r from-[#4fdbc8]/40 via-[#4fdbc8] to-transparent\" />\n        </div>\n\n        {/* Card 3: Suspicious Flags */}\n        <div className=\"relative overflow-hidden rounded-xl bg-[#191f2f] p-3 shadow-md border border-[#232a3a]/50\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"font-label-sm text-[10px] text-[#cbc3d7] uppercase tracking-wider\">Suspicious</span>\n            <div className=\"w-6 h-6 rounded-lg bg-[#232a3a] flex items-center justify-center text-[#ffb3ad]\">\n              <span className=\"material-symbols-outlined text-[16px]\">warning</span>\n            </div>\n          </div>\n          <div className=\"mt-1 flex flex-col\">\n            <span className=\"font-headline-lg-mobile text-[22px] font-bold text-[#dce2f7] tracking-tight\">\n              1,842\n            </span>\n            <div className=\"mt-0.5 inline-flex items-center gap-1 text-[#ffb3ad] font-label-sm text-[10px]\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-[#ffb3ad]\" />\n              <span>12.4% review</span>\n            </div>\n          </div>\n          <div className=\"absolute bottom-0 inset-x-0 h-0.5 bg-gradient-to-r from-[#ffb3ad]/40 via-[#ffb3ad] to-transparent\" />\n        </div>\n\n        {/* Card 4: Phishing Neutralized */}\n        <div className=\"relative overflow-hidden rounded-xl bg-[#191f2f] p-3 shadow-md border border-[#93000a]/30\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"font-label-sm text-[10px] text-[#cbc3d7] uppercase tracking-wider\">Neutralized</span>\n            <div className=\"w-6 h-6 rounded-lg bg-[#93000a]/30 flex items-center justify-center text-[#ffb4ab]\">\n              <span className=\"material-symbols-outlined text-[16px]\">gpp_bad</span>\n            </div>\n          </div>\n          <div className=\"mt-1 flex flex-col\">\n            <span className=\"font-headline-lg-mobile text-[22px] font-bold text-[#dce2f7] tracking-tight\">\n              640\n            </span>\n            <div className=\"mt-0.5 inline-flex items-center gap-1 text-[#ffb4ab] font-label-sm text-[10px]\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-[#ffb4ab] animate-pulse\" />\n              <span>4.3% critical</span>\n            </div>\n          </div>\n          <div className=\"absolute bottom-0 inset-x-0 h-0.5 bg-gradient-to-r from-[#ffb4ab]/40 via-[#ffb4ab] to-transparent\" />\n        </div>\n      </div>\n\n      {/* Risk Breakdown & Attack Vector Telemetry */}\n      <div className=\"rounded-xl bg-[#191f2f] p-4 shadow-md space-y-4 border border-[#232a3a]/50\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex flex-col\">\n            <span className=\"font-headline-sm text-[16px] text-[#dce2f7] font-semibold\">Risk Telemetry</span>\n            <span className=\"font-body-sm text-[12px] text-[#cbc3d7]\">Automated classification distribution</span>\n          </div>\n          <div className=\"px-2 py-0.5 rounded-full bg-[#2e3545] text-[#cbc3d7] font-label-sm text-[10px]\">\n            7-DAY WINDOW\n          </div>\n        </div>\n\n        {/* Inline Gauge SVG Breakdown */}\n        <div className=\"flex items-center gap-4\">\n          {/* Donut Visual SVG */}\n          <div className=\"relative w-28 h-28 shrink-0 flex items-center justify-center\">\n            <svg className=\"w-28 h-28 -rotate-90\" viewBox=\"0 0 100 100\">\n              {/* Background track */}\n              <circle cx=\"50\" cy=\"50\" fill=\"none\" r=\"38\" stroke=\"#232a3a\" strokeWidth=\"9\" />\n              {/* Clean segment: 83.3% -> circumference = 2 * PI * 38 = 238.76. 83.3% = 198.88 */}\n              <circle\n                cx=\"50\"\n                cy=\"50\"\n                fill=\"none\"\n                r=\"38\"\n                stroke=\"#4fdbc8\"\n                strokeDasharray=\"238.76\"\n                strokeDashoffset=\"40\"\n                strokeLinecap=\"round\"\n                strokeWidth=\"9\"\n              />\n              {/* Suspicious segment: 12.4% -> ~29.6 */}\n              <circle\n                cx=\"50\"\n                cy=\"50\"\n                fill=\"none\"\n                r=\"38\"\n                stroke=\"#ffb3ad\"\n                strokeDasharray=\"29.6 238.76\"\n                strokeDashoffset=\"-168\"\n                strokeLinecap=\"round\"\n                strokeWidth=\"9\"\n              />\n              {/* Phishing Critical: 4.3% -> ~10.2 */}\n              <circle\n                cx=\"50\"\n                cy=\"50\"\n                fill=\"none\"\n                r=\"38\"\n                stroke=\"#ff5451\"\n                strokeDasharray=\"10.2 238.76\"\n                strokeDashoffset=\"-200\"\n                strokeLinecap=\"round\"\n                strokeWidth=\"9\"\n              />\n            </svg>\n            <div className=\"absolute inset-0 flex flex-col items-center justify-center pointer-events-none\">\n              <span className=\"font-headline-sm text-base text-[#dce2f7] font-bold\">95.7%</span>\n              <span className=\"font-label-sm text-[9px] text-[#4fdbc8] uppercase font-semibold\">Filtered</span>\n            </div>\n          </div>\n\n          {/* Donut Legend Pills */}\n          <div className=\"flex flex-col justify-center space-y-2 flex-1 min-w-0\">\n            <div className=\"flex items-center justify-between text-[13px]\">\n              <div className=\"flex items-center gap-1.5 truncate\">\n                <span className=\"w-2 h-2 rounded-full bg-[#4fdbc8] shrink-0\" />\n                <span className=\"text-[#dce2f7] truncate\">Clean & Trusted</span>\n              </div>\n              <span className=\"font-label-sm text-xs text-[#dce2f7] ml-2 font-mono\">83.3%</span>\n            </div>\n            <div className=\"flex items-center justify-between text-[13px]\">\n              <div className=\"flex items-center gap-1.5 truncate\">\n                <span className=\"w-2 h-2 rounded-full bg-[#ffb3ad] shrink-0\" />\n                <span className=\"text-[#dce2f7] truncate\">Suspicious</span>\n              </div>\n              <span className=\"font-label-sm text-xs text-[#dce2f7] ml-2 font-mono\">12.4%</span>\n            </div>\n            <div className=\"flex items-center justify-between text-[13px]\">\n              <div className=\"flex items-center gap-1.5 truncate\">\n                <span className=\"w-2 h-2 rounded-full bg-[#ff5451] shrink-0\" />\n                <span className=\"text-[#dce2f7] truncate\">Malicious</span>\n              </div>\n              <span className=\"font-label-sm text-xs text-[#dce2f7] ml-2 font-mono\">4.3%</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Top Vectors Progression Bars */}\n        <div className=\"space-y-2 pt-1 border-t border-[#232a3a]/40\">\n          <span className=\"font-label-sm text-[10px] text-[#cbc3d7] uppercase tracking-wider\">\n            Top Intercepted Attack Vectors\n          </span>\n          <div className=\"space-y-1\">\n            <div className=\"flex justify-between font-label-sm text-[11px]\">\n              <span className=\"text-[#dce2f7] font-medium\">Typosquatting & Unicode Spoof</span>\n              <span className=\"text-[#d0bcff] font-code-md\">42%</span>\n            </div>\n            <div className=\"w-full h-1.5 rounded-full bg-[#232a3a] overflow-hidden\">\n              <div className=\"h-full rounded-full bg-[#d0bcff] transition-all duration-700\" style={{ width: \'42%\' }} />\n            </div>\n          </div>\n\n          <div className=\"space-y-1\">\n            <div className=\"flex justify-between font-label-sm text-[11px]\">\n              <span className=\"text-[#dce2f7] font-medium\">Credential Harvester Ingestion</span>\n              <span className=\"text-[#4fdbc8] font-code-md\">31%</span>\n            </div>\n            <div className=\"w-full h-1.5 rounded-full bg-[#232a3a] overflow-hidden\">\n              <div className=\"h-full rounded-full bg-[#4fdbc8] transition-all duration-700\" style={{ width: \'31%\' }} />\n            </div>\n          </div>\n\n          <div className=\"space-y-1\">\n            <div className=\"flex justify-between font-label-sm text-[11px]\">\n              <span className=\"text-[#dce2f7] font-medium\">Zero-Day SSL Chain Bypass</span>\n              <span className=\"text-[#ffb3ad] font-code-md\">27%</span>\n            </div>\n            <div className=\"w-full h-1.5 rounded-full bg-[#232a3a] overflow-hidden\">\n              <div className=\"h-full rounded-full bg-[#ffb3ad] transition-all duration-700\" style={{ width: \'27%\' }} />\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Real-Time Threat Activity Feed */}\n      <div className=\"rounded-xl bg-[#191f2f] p-4 shadow-md space-y-3 border border-[#232a3a]/50\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-2 h-2 rounded-full bg-[#ff5451] animate-ping\" />\n            <span className=\"font-headline-sm text-base text-[#dce2f7] font-semibold\">Live Intercept Feed</span>\n          </div>\n          <span className=\"font-label-sm text-[10px] text-[#d0bcff] uppercase tracking-wider font-mono\">\n            EXPAND (640)\n          </span>\n        </div>\n\n        {/* Feed Items */}\n        <div className=\"space-y-2\">\n          {feedItems.map((item, idx) => (\n            <div\n              key={idx}\n              onClick={() => onScanUrl(item.fullUrl)}\n              className=\"p-2.5 rounded-lg bg-[#141b2b] flex flex-col space-y-1 shadow-sm transition-all hover:bg-[#232a3a] cursor-pointer group border border-[#232a3a]/40\"\n            >\n              <div className=\"flex items-center justify-between gap-1\">\n                <div className=\"flex items-center gap-1.5 min-w-0\">\n                  <span className={`px-1.5 py-0.5 rounded font-label-sm text-[9px] shrink-0 font-bold uppercase ${item.statusClass}`}>\n                    {item.status}\n                  </span>\n                  <span className=\"font-code-md text-xs text-[#dce2f7] truncate font-semibold group-hover:text-[#4fdbc8] transition-colors\">\n                    {item.domain}\n                  </span>\n                </div>\n                <div className={`flex items-center gap-1 shrink-0 px-2 py-0.5 rounded-full font-label-sm text-[10px] font-mono font-bold ${item.scoreClass}`}>\n                  <span>{item.score}</span>\n                </div>\n              </div>\n              <div className=\"flex items-center justify-between text-xs text-[#cbc3d7]\">\n                <span className=\"truncate\">{item.payload}</span>\n                <span className=\"font-code-md text-[10px] text-[#958ea0] shrink-0 ml-2\">{item.time}</span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Interactive Security Knowledge Base & Sentinel Tips */}\n      <div className=\"rounded-xl bg-[#191f2f] p-4 shadow-md space-y-3 border border-[#232a3a]/50\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex flex-col\">\n            <span className=\"font-headline-sm text-base text-[#dce2f7] font-semibold\">SOC Defense Manual</span>\n            <span className=\"font-body-sm text-[12px] text-[#cbc3d7]\">Interactive awareness modules</span>\n          </div>\n          <span className=\"material-symbols-outlined text-[#d0bcff] text-[22px]\">psychology</span>\n        </div>\n\n        {/* Security Tips Horizontal Scroll / Snap Carousel */}\n        <div className=\"flex gap-3 overflow-x-auto pb-2 scrollbar-none snap-x snap-mandatory\">\n          {PLAYBOOK_MODULES.map((module) => (\n            <div\n              key={module.id}\n              onClick={() => onOpenPlaybook(module)}\n              className=\"snap-start shrink-0 w-[240px] rounded-xl bg-[#141b2b] p-3.5 flex flex-col justify-between shadow-sm relative overflow-hidden group active:scale-[0.98] transition-transform cursor-pointer border border-[#232a3a]/60 hover:border-[#a078ff]/40\"\n            >\n              <div className=\"space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <span className={`px-2 py-0.5 rounded-full font-label-sm text-[10px] uppercase font-bold ${module.tagColor}`}>\n                    {module.tag}\n                  </span>\n                  <span className=\"material-symbols-outlined text-[18px] text-[#cbc3d7] group-hover:text-[#4fdbc8] transition-colors\">\n                    {module.icon}\n                  </span>\n                </div>\n                <span className=\"font-headline-sm text-sm text-[#dce2f7] block leading-snug font-bold\">\n                  {module.title}\n                </span>\n                <p className=\"font-body-sm text-xs text-[#cbc3d7] line-clamp-2\">\n                  {module.description}\n                </p>\n              </div>\n              <div className=\"mt-3 flex items-center justify-between text-[#4fdbc8] font-label-sm text-[10px] uppercase font-semibold\">\n                <span>READ PLAYBOOK</span>\n                <span className=\"material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform\">\n                  arrow_forward\n                </span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n}\n"
