    replacement_chunks {
      replacement_content: "import { useState } from \'react\';\nimport { PlaybookModule } from \'../types\';\nimport { PLAYBOOK_MODULES } from \'../data/mockData\';\nimport {\n  Lightbulb,\n  ShieldCheck,\n  AlertTriangle,\n  ExternalLink,\n  CheckCircle2,\n  Lock,\n  Eye,\n  Terminal,\n  HelpCircle,\n  Sparkles,\n  ArrowRight,\n  Search,\n} from \'lucide-react\';\n\ninterface SecurityTipsViewProps {\n  onOpenPlaybook: (playbook: PlaybookModule) => void;\n  onScanUrl: (url: string) => void;\n}\n\nexport default function SecurityTipsView({ onOpenPlaybook, onScanUrl }: SecurityTipsViewProps) {\n  const [selectedCategory, setSelectedCategory] = useState<\'all\' | \'heuristics\' | \'credentials\' | \'infrastructure\'>(\'all\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  // Interactive Checklist State\n  const [checkedItems, setCheckedItems] = useState<Record<string, boolean>>({\n    \'chk-1\': true,\n    \'chk-2\': true,\n    \'chk-3\': false,\n    \'chk-4\': false,\n    \'chk-5\': true,\n  });\n\n  const toggleCheck = (id: string) => {\n    setCheckedItems((prev) => ({ ...prev, [id]: !prev[id] }));\n  };\n\n  const threatTips = [\n    {\n      id: \'tip-1\',\n      title: \'Zero-Day Punycode & Cyrillic Homoglyphs\',\n      category: \'heuristics\',\n      severity: \'High Threat\',\n      severityColor: \'text-amber-400 bg-amber-500/10 border-amber-500/20\',\n      summary: \'Attackers substitute Latin \"o\" with Cyrillic \"\320\276\" (U+043E) or digit \"0\" in domains like \"wellsfarg0\" or \"app\323\217e.com\".\',\n      actionableAdvice: \'Always inspect the decoded ASCII punycode (prefixed with xn--) in security headers or PhishGuard URL Scanner before allowing user credentials.\',\n      sampleTarget: \'https://wellsfarg0-verify.com/auth\',\n      playbookId: \'pb-1\',\n    },\n    {\n      id: \'tip-2\',\n      title: \'Adversary-in-the-Middle (AiTM) Reverse Proxies\',\n      category: \'credentials\',\n      severity: \'Critical Threat\',\n      severityColor: \'text-rose-400 bg-rose-500/10 border-rose-500/20\',\n      summary: \'Frameworks like Evilginx proxy authentic Microsoft 365 or Okta logins, stealing session cookies and bypassing TOTP / Push MFA.\',\n      actionableAdvice: \'Transition to FIDO2 / WebAuthn hardware security keys which bind authentication credentials cryptographically to the exact origin domain.\',\n      sampleTarget: \'https://login-apple-icloud-security.net\',\n      playbookId: \'pb-3\',\n    },\n    {\n      id: \'tip-3\',\n      title: \'Ephemeral Let\\\'s Encrypt SSL Certificates\',\n      category: \'infrastructure\',\n      severity: \'Suspicious\',\n      severityColor: \'text-orange-400 bg-orange-500/10 border-orange-500/20\',\n      summary: \'Over 82% of modern phishing landing pages now utilize free SSL certificates created less than 48 hours prior to campaign launch.\',\n      actionableAdvice: \'Enforce gateway policies flagging domain age under 14 days and certificates issued with automated zero-verification root authorities.\',\n      sampleTarget: \'https://cryptowallet-ledger-airdrop.xyz\',\n      playbookId: \'pb-2\',\n    },\n    {\n      id: \'tip-4\',\n      title: \'Quishing: QR Code Phishing in Invoices\',\n      category: \'heuristics\',\n      severity: \'High Threat\',\n      severityColor: \'text-amber-400 bg-amber-500/10 border-amber-500/20\',\n      summary: \'Attackers embed malicious QR codes inside PDF attachments or email signatures to move victims from corporate laptops to unmanaged personal phones.\',\n      actionableAdvice: \'Implement optical neural OCR inspection on inbound PDF attachments to automatically extract and scan embedded QR destinations.\',\n      sampleTarget: \'https://paypal-security-update-login.top/signin\',\n      playbookId: \'pb-2\',\n    },\n    {\n      id: \'tip-5\',\n      title: \'Subdomain Takeover & CNAME Dangling\',\n      category: \'infrastructure\',\n      severity: \'Medium Threat\',\n      severityColor: \'text-purple-400 bg-purple-500/10 border-purple-500/20\',\n      summary: \'Dangling DNS records pointing to decommissioned S3 buckets, GitHub Pages, or Azure blobs can be claimed by attackers to phish on trusted root domains.\',\n      actionableAdvice: \'Audit corporate DNS zones regularly for orphaned CNAME records and configure automated DNS hygiene sweeps.\',\n      sampleTarget: \'https://docs.github.com/en/rest\',\n      playbookId: \'pb-1\',\n    },\n  ];\n\n  const checklistItems = [\n    {\n      id: \'chk-1\',\n      title: \'Canonical Domain Verification\',\n      desc: \'Verify top-level domain matches authoritative trademark registry without deceptive subdomains.\',\n    },\n    {\n      id: \'chk-2\',\n      title: \'HTTPS Certificate Age & Organization Validation\',\n      desc: \'Confirm TLS certificate is older than 30 days and matches the stated corporate entity.\',\n    },\n    {\n      id: \'chk-3\',\n      title: \'AiTM Header & Cookie Flag Check\',\n      desc: \'Inspect whether SameSite=Strict and Secure cookies are present and untampered.\',\n    },\n    {\n      id: \'chk-4\',\n      title: \'FIDO2 / WebAuthn Hardware Binding\',\n      desc: \'Require hardware passkeys resistant to adversary-in-the-middle session interception.\',\n    },\n    {\n      id: \'chk-5\',\n      title: \'Automated Heuristic URL Sandboxing\',\n      desc: \'Submit all suspicious links through PhishGuard neural parser before opening.\',\n    },\n  ];\n\n  const filteredTips = threatTips.filter((tip) => {\n    const matchesCategory = selectedCategory === \'all\' || tip.category === selectedCategory;\n    const matchesSearch =\n      !searchQuery ||\n      tip.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      tip.summary.toLowerCase().includes(searchQuery.toLowerCase());\n    return matchesCategory && matchesSearch;\n  });\n\n  return (\n    <div className=\"w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6\">\n      {/* Top Banner */}\n      <div className=\"rounded-2xl bg-gradient-to-r from-[#171a24] via-[#141721] to-[#12141c] border border-[#262c3b] p-6 shadow-xl relative overflow-hidden\">\n        <div className=\"absolute right-0 top-0 w-80 h-80 bg-purple-600/10 rounded-full blur-3xl pointer-events-none\" />\n        <div className=\"absolute left-1/3 bottom-0 w-60 h-60 bg-teal-500/10 rounded-full blur-3xl pointer-events-none\" />\n\n        <div className=\"relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6\">\n          <div className=\"space-y-2 max-w-2xl\">\n            <div className=\"inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-purple-500/15 text-purple-300 text-xs font-semibold border border-purple-500/30\">\n              <Sparkles className=\"w-3.5 h-3.5 text-purple-400\" />\n              <span>PhishGuard Threat Intelligence & Defense Guide</span>\n            </div>\n            <h1 className=\"text-2xl sm:text-3xl font-bold text-white tracking-tight\">\n              Security Tips & Incident Playbooks\n            </h1>\n            <p className=\"text-sm text-zinc-400 leading-relaxed\">\n              Actionable threat hunting procedures, deception analysis, and defensive countermeasures curated by PhishGuard SOC analysts to protect against evasive phishing techniques.\n            </p>\n          </div>\n\n          <div className=\"flex flex-col sm:flex-row gap-3 shrink-0\">\n            <button\n              onClick={() => onOpenPlaybook(PLAYBOOK_MODULES[0])}\n              className=\"px-4 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold shadow-[0_0_20px_rgba(168,85,247,0.3)] transition-all flex items-center justify-center gap-2 cursor-pointer\"\n            >\n              <Lightbulb className=\"w-4 h-4 text-purple-200\" />\n              <span>Explore Playbooks</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Main 2-Column Content Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Left 2 Cols: Threat Tips & Tactical Guidance */}\n        <div className=\"lg:col-span-2 space-y-4\">\n          {/* Controls: Category Filter & Search */}\n          <div className=\"flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between\">\n            <div className=\"flex flex-wrap gap-1.5 p-1 rounded-xl bg-[#141722] border border-[#242a38]\">\n              {(\n                [\n                  { id: \'all\', label: \'All Tips\' },\n                  { id: \'heuristics\', label: \'Heuristics & Deception\' },\n                  { id: \'credentials\', label: \'AiTM & Credentials\' },\n                  { id: \'infrastructure\', label: \'Infrastructure & SSL\' },\n                ] as const\n              ).map((cat) => (\n                <button\n                  key={cat.id}\n                  onClick={() => setSelectedCategory(cat.id)}\n                  className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer ${\n                    selectedCategory === cat.id\n                      ? \'bg-purple-600/20 text-purple-300 border border-purple-500/40\'\n                      : \'text-zinc-400 hover:text-white\'\n                  }`}\n                >\n                  {cat.label}\n                </button>\n              ))}\n            </div>\n\n            <div className=\"relative min-w-[200px]\">\n              <Search className=\"w-4 h-4 text-zinc-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n              <input\n                type=\"text\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                placeholder=\"Search defense tips...\"\n                className=\"w-full pl-9 pr-3 py-2 rounded-xl bg-[#141722] border border-[#242a38] text-xs text-white placeholder:text-zinc-500 focus:outline-none focus:border-purple-500\"\n              />\n            </div>\n          </div>\n\n          {/* Tips List */}\n          <div className=\"space-y-3\">\n            {filteredTips.map((tip) => {\n              const matchedPlaybook = PLAYBOOK_MODULES.find((p) => p.id === tip.playbookId) || PLAYBOOK_MODULES[0];\n              return (\n                <div\n                  key={tip.id}\n                  className=\"rounded-xl bg-[#141722] border border-[#242a38] hover:border-[#353d52] p-5 shadow-sm transition-all space-y-3 group\"\n                >\n                  <div className=\"flex items-start justify-between gap-3\">\n                    <div className=\"space-y-1 min-w-0\">\n                      <div className=\"flex items-center gap-2 flex-wrap\">\n                        <span className={`text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded-full border ${tip.severityColor}`}>\n                          {tip.severity}\n                        </span>\n                        <span className=\"text-xs font-mono text-zinc-500 uppercase\">\n                          {tip.category}\n                        </span>\n                      </div>\n                      <h2 className=\"text-base font-bold text-white group-hover:text-purple-300 transition-colors\">\n                        {tip.title}\n                      </h2>\n                    </div>\n\n                    <button\n                      onClick={() => onOpenPlaybook(matchedPlaybook)}\n                      className=\"shrink-0 px-3 py-1.5 rounded-lg bg-[#1b2030] hover:bg-purple-600/20 text-zinc-300 hover:text-purple-200 border border-[#2a3245] hover:border-purple-500/40 text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer\"\n                    >\n                      <span>Read Playbook</span>\n                      <ArrowRight className=\"w-3.5 h-3.5\" />\n                    </button>\n                  </div>\n\n                  <p className=\"text-xs text-zinc-300 leading-relaxed\">\n                    {tip.summary}\n                  </p>\n\n                  {/* Actionable Advice Box */}\n                  <div className=\"p-3 rounded-lg bg-[#0e1118] border border-teal-500/20 flex items-start gap-2.5 text-xs text-teal-300\">\n                    <ShieldCheck className=\"w-4 h-4 text-teal-400 shrink-0 mt-0.5\" />\n                    <div>\n                      <span className=\"font-bold text-teal-200\">Recommended Countermeasure: </span>\n                      <span className=\"text-zinc-300\">{tip.actionableAdvice}</span>\n                    </div>\n                  </div>\n\n                  {/* Quick Target Test Trigger */}\n                  <div className=\"pt-2 flex items-center justify-between border-t border-[#202535] text-[11px] text-zinc-400\">\n                    <div className=\"flex items-center gap-1.5 truncate\">\n                      <Terminal className=\"w-3.5 h-3.5 text-purple-400 shrink-0\" />\n                      <span className=\"font-mono text-zinc-500 truncate\">Example Target:</span>\n                      <span className=\"font-mono text-zinc-300 truncate\">{tip.sampleTarget}</span>\n                    </div>\n                    <button\n                      onClick={() => onScanUrl(tip.sampleTarget)}\n                      className=\"shrink-0 text-purple-400 hover:text-purple-300 font-semibold flex items-center gap-1 cursor-pointer\"\n                    >\n                      <span>Inspect in Scanner</span>\n                      <ExternalLink className=\"w-3 h-3\" />\n                    </button>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Right Col: Interactive Verification Checklist & Threat Matrix */}\n        <div className=\"space-y-4\">\n          {/* Interactive Checklist Card */}\n          <div className=\"rounded-xl bg-[#141722] border border-[#242a38] p-5 shadow-sm space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-8 h-8 rounded-lg bg-teal-500/15 border border-teal-500/30 flex items-center justify-center text-teal-400\">\n                  <CheckCircle2 className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <h2 className=\"text-sm font-bold text-white\">SOC URL Audit Checklist</h2>\n                  <span className=\"text-[11px] text-zinc-400 font-mono\">Pre-execution verification</span>\n                </div>\n              </div>\n              <span className=\"text-xs font-mono font-bold text-teal-400 bg-teal-500/10 px-2 py-0.5 rounded border border-teal-500/20\">\n                {Object.values(checkedItems).filter(Boolean).length}/{checklistItems.length} PASS\n              </span>\n            </div>\n\n            <p className=\"text-xs text-zinc-400\">\n              Check off threat indicators when triaging suspicious incident tickets:\n            </p>\n\n            <div className=\"space-y-2.5\">\n              {checklistItems.map((item) => {\n                const isChecked = !!checkedItems[item.id];\n                return (\n                  <div\n                    key={item.id}\n                    onClick={() => toggleCheck(item.id)}\n                    className={`p-3 rounded-lg border transition-all cursor-pointer flex items-start gap-3 ${\n                      isChecked\n                        ? \'bg-teal-950/20 border-teal-500/30 text-zinc-200\'\n                        : \'bg-[#10131d] border-[#222736] text-zinc-400 hover:border-zinc-700\'\n                    }`}\n                  >\n                    <input\n                      type=\"checkbox\"\n                      checked={isChecked}\n                      onChange={() => toggleCheck(item.id)}\n                      className=\"mt-0.5 rounded text-teal-500 focus:ring-0 focus:ring-offset-0 bg-zinc-800 border-zinc-700 cursor-pointer\"\n                    />\n                    <div className=\"flex flex-col min-w-0\">\n                      <span className={`text-xs font-semibold ${isChecked ? \'text-white\' : \'text-zinc-300\'}`}>\n                        {item.title}\n                      </span>\n                      <span className=\"text-[11px] text-zinc-500 leading-tight mt-0.5\">\n                        {item.desc}\n                      </span>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* MITRE ATT&CK Matrix Quick Reference */}\n          <div className=\"rounded-xl bg-[#141722] border border-[#242a38] p-5 shadow-sm space-y-3\">\n            <div className=\"flex items-center gap-2\">\n              <Lock className=\"w-4 h-4 text-purple-400\" />\n              <h2 className=\"text-sm font-bold text-white\">MITRE ATT&CK\302\256 T1566 Phishing</h2>\n            </div>\n            <p className=\"text-xs text-zinc-400\">\n              PhishGuard autonomous heuristics correlate against standard adversarial vectors:\n            </p>\n\n            <div className=\"space-y-2 font-mono text-[11px]\">\n              <div className=\"p-2 rounded bg-[#0e1118] border border-[#222736] flex justify-between items-center\">\n                <span className=\"text-zinc-300\">T1566.001 Spearphishing Attachment</span>\n                <span className=\"text-purple-400 font-bold\">OCR Monitored</span>\n              </div>\n              <div className=\"p-2 rounded bg-[#0e1118] border border-[#222736] flex justify-between items-center\">\n                <span className=\"text-zinc-300\">T1566.002 Spearphishing Link</span>\n                <span className=\"text-teal-400 font-bold\">Real-time Intercept</span>\n              </div>\n              <div className=\"p-2 rounded bg-[#0e1118] border border-[#222736] flex justify-between items-center\">\n                <span className=\"text-zinc-300\">T1566.003 Spearphishing via Service</span>\n                <span className=\"text-orange-400 font-bold\">Heuristic Block</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
