    content: "          timestamp: new Date().toISOString().substring(11, 19) + \' UTC\',\n          text: `Understood, Analyst. Telemetry telemetry cross-referenced across 6 radar clusters. The system is actively inspecting live DNS streams, reverse proxy gateways, and zero-day typosquatting domains. Let me know if you would like me to isolate an origin, unpack a token payload, or parse raw headers.`,\n        };\n      }\n\n      setIsThinking(false);\n      setMessages((prev) => [...prev, botResponse]);\n      if (botResponse.text) {\n        speakText(botResponse.text.substring(0, 150));\n      }\n    }, 1100);\n  };\n\n  const handleSinkhole = (domain?: string) => {\n    onShowToast(`DNS Sinkhole applied for ${domain || \'origin domain\'}. Routing dropped.`, true);\n  };\n\n  const handleShareTicket = (domain?: string) => {\n    onShowToast(`SIEM Ticket #INC-9482 created in Splunk & Sentinel for ${domain || \'incident\'}.`);\n  };\n\n  return (\n    <div className=\"flex flex-col w-full max-w-lg mx-auto px-4 py-3 space-y-4 pb-20 text-[#dce2f7]\">\n      {/* AI Sentinel Status Header & Mode Switcher */}\n      <section className=\"flex flex-col w-full bg-[#141b2b] rounded-xl p-4 shadow-lg relative overflow-hidden border border-[#232a3a]/60\">\n        <div className=\"absolute -top-12 -right-12 w-40 h-40 bg-[#a078ff]/20 rounded-full blur-3xl pointer-events-none\" />\n        <div className=\"flex items-start justify-between gap-3 relative z-10\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"relative flex items-center justify-center w-12 h-12 rounded-xl bg-[#2e3545] shadow-[0_0_20px_rgba(160,120,255,0.35)]\">\n              <span\n                className=\"material-symbols-outlined text-[#d0bcff] text-[28px]\"\n                style={{ fontVariationSettings: \"\'FILL\' 1\" }}\n              >\n                psychology\n              </span>\n              <span className=\"absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-[#4fdbc8] rounded-full shadow-[0_0_8px_#4fdbc8] animate-pulse\" />\n            </div>\n            <div className=\"flex flex-col\">\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"font-headline-sm text-base text-[#dce2f7] font-bold\">Sentinel AI Advisor</h1>\n                <span className=\"px-1.5 py-0.5 rounded-full bg-[#a078ff]/20 text-[#d0bcff] font-label-sm text-[10px] uppercase tracking-wider font-mono\">"
    raw_content: "import { useState, useRef, useEffect } from \'react\';\nimport { ChatMessage } from \'../types\';\nimport { INITIAL_CHAT_MESSAGES } from \'../data/mockData\';\n\ninterface SentinelAiAssistantProps {\n  onShowToast: (msg: string, isAlert?: boolean) => void;\n  onInspectUrl: (url: string) => void;\n}\n\nexport default function SentinelAiAssistant({ onShowToast, onInspectUrl }: SentinelAiAssistantProps) {\n  const [messages, setMessages] = useState<ChatMessage[]>(INITIAL_CHAT_MESSAGES);\n  const [inputValue, setInputValue] = useState(\'\');\n  const [voiceActive, setVoiceActive] = useState(true);\n  const [audioFeedback, setAudioFeedback] = useState(true);\n  const [isThinking, setIsThinking] = useState(false);\n  const messagesEndRef = useRef<HTMLDivElement>(null);\n\n  const scrollToBottom = () => {\n    messagesEndRef.current?.scrollIntoView({ behavior: \'smooth\' });\n  };\n\n  useEffect(() => {\n    scrollToBottom();\n  }, [messages, isThinking]);\n\n  const speakText = (text: string) => {\n    if (!audioFeedback || typeof window === \'undefined\' || !(\'speechSynthesis\' in window)) return;\n    try {\n      window.speechSynthesis.cancel();\n      const utterance = new SpeechSynthesisUtterance(text);\n      utterance.rate = 1.05;\n      utterance.pitch = 0.95;\n      window.speechSynthesis.speak(utterance);\n    } catch {\n      // Audio synthesis fallback\n    }\n  };\n\n  const handleSendMessage = (textToSend?: string) => {\n    const query = textToSend || inputValue.trim();\n    if (!query) return;\n\n    const userMsg: ChatMessage = {\n      id: `msg-${Date.now()}`,\n      sender: \'analyst\',\n      timestamp: new Date().toISOString().substring(11, 19) + \' UTC\',\n      text: query,\n    };\n\n    setMessages((prev) => [...prev, userMsg]);\n    setInputValue(\'\');\n    setIsThinking(true);\n\n    // Simulate Sentinel AI Expert Reasoning\n    setTimeout(() => {\n      let botResponse: ChatMessage;\n      const lower = query.toLowerCase();\n\n      if (lower.includes(\'punycode\')) {\n        botResponse = {\n          id: `msg-${Date.now() + 1}`,\n          sender: \'sentinel\',\n          timestamp: new Date().toISOString().substring(11, 19) + \' UTC\',\n          text: `Punycode (RFC 3492) transforms Internationalized Domain Names (IDNs) into an ASCII-Compatible Encoding prefixed with \"xn--\".\\n\\nThreat actors exploit this via Homograph Attacks by substituting identical-looking Cyrillic or Greek glyphs (e.g. Cyrillic \"\320\260\" U+0430 for Latin \"a\" U+0061). Modern browsers convert the address bar to Punycode if mixed scripts are detected in the same label to protect against spoofing.`,\n        };\n      } else if (lower.includes(\'oauth\')) {\n        botResponse = {\n          id: `msg-${Date.now() + 1}`,\n          sender: \'sentinel\',\n          timestamp: new Date().toISOString().substring(11, 19) + \' UTC\',\n          text: `Fake OAuth Consent Phishing (Illicit Consent Grants) tricks users into authorizing a rogue Azure AD or Google Workspace app requesting permissions like \'Mail.ReadWrite\' or \'Offline_Access\'.\\n\\nKey Red Flags:\\n1. Unverified Publisher badge missing\\n2. Excessive administrative tenant scopes\\n3. Client redirect URI pointing to dynamic webhooks or untrusted IP addresses.`,\n        };\n      } else if (lower.includes(\'yara\')) {\n        botResponse = {\n          id: `msg-${Date.now() + 1}`,\n          sender: \'sentinel\',\n          timestamp: new Date().toISOString().substring(11, 19) + \' UTC\',\n          text: `Here is the generated YARA rule for this threat cluster:\\n\\nrule PhishGuard_WellsFargo_Harvest_2026 {\\n  meta:\\n    author = \"Sentinel AI Advisor\"\\n    severity = \"CRITICAL\"\\n  strings:\\n    $s1 = \"wellsfarg0\" nocase\\n    $s2 = \"eval(unescape(\" ascii\\n    $post = \"185.220.101.5\" ascii\\n  condition:\\n    2 of ($s*) and $post\\n}`,\n        };\n      } else if (lower.includes(\'sinkhole\') || lower.includes(\'quarantine\')) {\n        botResponse = {\n          id: `msg-${Date.now() + 1}`,\n          sender: \'sentinel\',\n          timestamp: new Date().toISOString().substring(11, 19) + \' UTC\',\n          text: `Active Sinkhole Ingestion Triggered. Domain routing table modified to localhost (127.0.0.1) across all DNS forwarders. Network edge firewalls updated to drop TCP SYN packets to ASN 49505.`,\n        };\n      } else if (lower.includes(\'http\') || lower.includes(\'.com\') || lower.includes(\'.net\') || lower.includes(\'.org\')) {\n        botResponse = {\n          id: `msg-${Date.now() + 1}`,\n          sender: \'sentinel\',\n          timestamp: new Date().toISOString().substring(11, 19) + \' UTC\',\n          isStructuredVerdict: true,\n          verdictTitle: \'ANOMALY INGESTION RESULT\',\n          verdictDomain: query,\n          confidence: \'98.6% HEURISTIC INDEX\',\n          findings: [\n            {\n              title: \'1. Autonomous Heuristic Evaluation\',\n              desc: \'Subdomain variance and certificate authority lifecycle flagged for high entropy divergence.\',\n              icon: \'warning\',\n              type: \'warning\',\n            },\n            {\n              title: \'2. DOM & Canvas Replication Scan\',\n              desc: \'Synthetic headless inspection detected clone signatures mimicking enterprise login gateways.\',\n              icon: \'history\',\n              type: \'history\',\n            },\n          ],\n          recommendation: \'Target has been queued for continuous telemetry monitoring. You may inspect full packet forensics in the URL Scanner.\',\n          actions: {\n            sinkhole: true,\n            shareTicket: true,\n          },\n        };\n      } else {\n        botResponse = {\n          id: `msg-${Date.now() + 1}`,\n          sender: \'sentinel\',\n          timestamp: new Date().toISOString().substring(11, 19) + \' UTC\',\n          text: `Understood, Analyst. Telemetry telemetry cross-referenced across 6 radar clusters. The system is actively inspecting live DNS streams, reverse proxy gateways, and zero-day typosquatting domains. Let me know if you would like me to isolate an origin, unpack a token payload, or parse raw headers.`,\n        };\n      }\n\n      setIsThinking(false);\n      setMessages((prev) => [...prev, botResponse]);\n      if (botResponse.text) {\n        speakText(botResponse.text.substring(0, 150));\n      }\n    }, 1100);\n  };\n\n  const handleSinkhole = (domain?: string) => {\n    onShowToast(`DNS Sinkhole applied for ${domain || \'origin domain\'}. Routing dropped.`, true);\n  };\n\n  const handleShareTicket = (domain?: string) => {\n    onShowToast(`SIEM Ticket #INC-9482 created in Splunk & Sentinel for ${domain || \'incident\'}.`);\n  };\n\n  return (\n    <div className=\"flex flex-col w-full max-w-lg mx-auto px-4 py-3 space-y-4 pb-20 text-[#dce2f7]\">\n      {/* AI Sentinel Status Header & Mode Switcher */}\n      <section className=\"flex flex-col w-full bg-[#141b2b] rounded-xl p-4 shadow-lg relative overflow-hidden border border-[#232a3a]/60\">\n        <div className=\"absolute -top-12 -right-12 w-40 h-40 bg-[#a078ff]/20 rounded-full blur-3xl pointer-events-none\" />\n        <div className=\"flex items-start justify-between gap-3 relative z-10\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"relative flex items-center justify-center w-12 h-12 rounded-xl bg-[#2e3545] shadow-[0_0_20px_rgba(160,120,255,0.35)]\">\n              <span\n                className=\"material-symbols-outlined text-[#d0bcff] text-[28px]\"\n                style={{ fontVariationSettings: \"\'FILL\' 1\" }}\n              >\n                psychology\n              </span>\n              <span className=\"absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-[#4fdbc8] rounded-full shadow-[0_0_8px_#4fdbc8] animate-pulse\" />\n            </div>\n            <div className=\"flex flex-col\">\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"font-headline-sm text-base text-[#dce2f7] font-bold\">Sentinel AI Advisor</h1>\n                <span className=\"px-1.5 py-0.5 rounded-full bg-[#a078ff]/20 text-[#d0bcff] font-label-sm text-[10px] uppercase tracking-wider font-mono\">\n                  v4.5\n                </span>\n              </div>\n              <p className=\"font-label-sm text-[11px] text-[#4fdbc8] flex items-center gap-1.5 mt-0.5\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-[#4fdbc8]\" />\n                PhishShield Engine \342\200\242 Real-time Threat Intel\n              </p>\n            </div>\n          </div>\n          <button\n            aria-label=\"Toggle Audio Feedback\"\n            onClick={() => {\n              setAudioFeedback(!audioFeedback);\n              onShowToast(audioFeedback ? \'Voice synthesis muted\' : \'Voice synthesis active\');\n            }}\n            className=\"w-9 h-9 flex items-center justify-center rounded-lg bg-[#191f2f] hover:bg-[#232a3a] text-[#cbc3d7] transition-colors border border-[#232a3a]\"\n          >\n            <span className=\"material-symbols-outlined text-[18px]\">\n              {audioFeedback ? \'volume_up\' : \'volume_off\'}\n            </span>\n          </button>\n        </div>\n\n        {/* Mode Selector Pills */}\n        <div className=\"mt-4 grid grid-cols-2 p-1 bg-[#070e1d] rounded-lg gap-1 relative z-10 border border-[#232a3a]\">\n          <button\n            onClick={() => setVoiceActive(false)}\n            className={`flex items-center justify-center gap-1.5 py-2 rounded-lg font-label-md text-xs transition-all ${\n              !voiceActive\n                ? \'bg-[#d0bcff] text-[#3c0091] font-bold shadow-[0_0_14px_rgba(160,120,255,0.4)]\'\n                : \'text-[#cbc3d7] hover:text-[#dce2f7]\'\n            }`}\n          >\n            <span className=\"material-symbols-outlined text-[16px]\">terminal</span>\n            TEXT ANALYSIS\n          </button>\n          <button\n            onClick={() => setVoiceActive(true)}\n            className={`flex items-center justify-center gap-1.5 py-2 rounded-lg font-label-md text-xs transition-all ${\n              voiceActive\n                ? \'bg-[#d0bcff] text-[#3c0091] font-bold shadow-[0_0_14px_rgba(160,120,255,0.4)]\'\n                : \'text-[#cbc3d7] hover:text-[#dce2f7]\'\n            }`}\n          >\n            <span\n              className=\"material-symbols-outlined text-[16px]\"\n              style={{ fontVariationSettings: \"\'FILL\' 1\" }}\n            >\n              graphic_eq\n            </span>\n            VOICE ACTIVE\n          </button>\n        </div>\n      </section>\n\n      {/* Interactive Voice Waveform Orb Diagnostic Box */}\n      {voiceActive && (\n        <section className=\"flex flex-col items-center justify-center w-full bg-[#070e1d] rounded-xl p-6 shadow-xl relative overflow-hidden border border-[#232a3a]/80\">\n          <div className=\"absolute inset-0 bg-gradient-to-b from-[#a078ff]/10 via-transparent to-[#04b4a2]/5 pointer-events-none\" />\n\n          {/* Pulse Radar Ripples */}\n          <div className=\"relative flex items-center justify-center w-36 h-36 my-2\">\n            <div className=\"absolute inset-0 rounded-full bg-[#d0bcff]/10 animate-ping opacity-30\" />\n            <div className=\"absolute inset-2 rounded-full bg-[#a078ff]/15 animate-pulse\" />\n            <div className=\"absolute inset-5 rounded-full bg-[#232a3a] shadow-[inset_0_0_24px_rgba(160,120,255,0.3)]\" />\n\n            {/* Core Listening Button */}\n            <button\n              aria-label=\"Tap to speak\"\n              onClick={() => {\n                onShowToast(\'Listening for analyst voice query...\');\n                setInputValue(\'Analyze wellsfarg0-verify.com\');\n              }}\n              className=\"relative z-10 w-20 h-20 rounded-full bg-[#d0bcff] text-[#3c0091] flex flex-col items-center justify-center shadow-[0_0_32px_rgba(160,120,255,0.6)] active:scale-95 transition-transform cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[32px]\">mic</span>\n              <span className=\"font-label-sm text-[8px] uppercase tracking-tighter mt-0.5 font-bold\">\n                TAP TO SPEAK\n              </span>\n            </button>\n\n            {/* SVG Kinetic Orbit Particles */}\n            <svg\n              className=\"absolute inset-0 w-full h-full animate-spin pointer-events-none\"\n              style={{ animationDuration: \'16s\' }}\n              viewBox=\"0 0 144 144\"\n            >\n              <circle className=\"fill-[#4fdbc8] shadow-[0_0_8px_#4fdbc8]\" cx=\"72\" cy=\"6\" r=\"3\" />\n              <circle className=\"fill-[#d0bcff]\" cx=\"138\" cy=\"72\" r=\"2\" />\n              <circle className=\"fill-[#4fdbc8]\" cx=\"6\" cy=\"72\" r=\"2.5\" />\n            </svg>\n          </div>\n\n          {/* Live Telemetry Frequency Bars */}\n          <div className=\"flex items-center justify-center gap-1.5 h-8 my-2 w-full max-w-xs\">\n            <span className=\"w-1 bg-[#4fdbc8] rounded-full animate-pulse h-3\" />\n            <span className=\"w-1 bg-[#d0bcff] rounded-full animate-pulse h-6\" style={{ animationDelay: \'120ms\' }} />\n            <span className=\"w-1 bg-[#a078ff] rounded-full animate-pulse h-4\" style={{ animationDelay: \'240ms\' }} />\n            <span className=\"w-1 bg-[#4fdbc8] rounded-full animate-pulse h-7\" style={{ animationDelay: \'80ms\' }} />\n            <span className=\"w-1 bg-[#d0bcff] rounded-full animate-pulse h-8\" style={{ animationDelay: \'310ms\' }} />\n            <span className=\"w-1 bg-[#4fdbc8] rounded-full animate-pulse h-5\" style={{ animationDelay: \'150ms\' }} />\n            <span className=\"w-1 bg-[#d0bcff] rounded-full animate-pulse h-7\" style={{ animationDelay: \'200ms\' }} />\n            <span className=\"w-1 bg-[#d0bcff] rounded-full animate-pulse h-4\" style={{ animationDelay: \'270ms\' }} />\n            <span className=\"w-1 bg-[#4fdbc8] rounded-full animate-pulse h-6\" style={{ animationDelay: \'190ms\' }} />\n            <span className=\"w-1 bg-[#a078ff] rounded-full animate-pulse h-2\" style={{ animationDelay: \'90ms\' }} />\n          </div>\n\n          <p className=\"font-code-md text-xs text-[#4fdbc8] tracking-wide text-center\">\n            Listening... speak a URL, paste code, or ask about an incident\n          </p>\n          <span className=\"font-label-sm text-[9px] text-[#958ea0] mt-1 tracking-widest uppercase font-mono\">\n            AUDIO ENCRYPTION ACTIVE \342\200\242 TLS 1.3\n          </span>\n        </section>\n      )}\n\n      {/* Conversational Analytical Timeline Stream */}\n      <section className=\"flex flex-col w-full space-y-4\">\n        {messages.map((msg) => {\n          if (msg.sender === \'sentinel\' && !msg.isStructuredVerdict) {\n            return (\n              <div key={msg.id} className=\"flex items-start gap-2.5 max-w-[95%]\">\n                <div className=\"w-8 h-8 rounded-lg bg-[#a078ff]/20 text-[#d0bcff] flex items-center justify-center shrink-0 mt-1 shadow-sm\">\n                  <span className=\"material-symbols-outlined text-[18px]\">smart_toy</span>\n                </div>\n                <div className=\"flex flex-col bg-[#141b2b] rounded-xl rounded-tl-none p-3.5 shadow-md space-y-1 text-[#dce2f7] border border-[#232a3a]\">\n                  <div className=\"flex items-center justify-between gap-4\">\n                    <span className=\"font-label-sm text-[10px] text-[#d0bcff] font-bold tracking-wider uppercase\">\n                      SENTINEL AI\n                    </span>\n                    <span className=\"font-label-sm text-[10px] text-[#958ea0] font-mono\">{msg.timestamp}</span>\n                  </div>\n                  <p className=\"font-body-md text-xs leading-relaxed text-[#cbc3d7] whitespace-pre-line\">\n                    {msg.text}\n                  </p>\n                </div>\n              </div>\n            );\n          }\n\n          if (msg.sender === \'analyst\') {\n            return (\n              <div key={msg.id} className=\"flex items-start justify-end gap-2.5 max-w-[92%] self-end\">\n                <div className=\"flex flex-col bg-[#d0bcff] text-[#3c0091] rounded-xl rounded-tr-none p-3.5 shadow-md space-y-1\">\n                  <div className=\"flex items-center justify-between gap-4\">\n                    <span className=\"font-label-sm text-[10px] text-[#3c0091] font-bold tracking-wider uppercase\">\n                      ANALYST (YOU)\n                    </span>\n                    <span className=\"font-label-sm text-[10px] opacity-75 font-mono\">{msg.timestamp}</span>\n                  </div>\n                  <p className=\"font-body-md text-xs font-semibold\">\n                    {msg.text}\n                  </p>\n                </div>\n                <div className=\"w-8 h-8 rounded-lg bg-[#2e3545] text-[#4fdbc8] flex items-center justify-center shrink-0 mt-1 shadow-sm\">\n                  <span className=\"material-symbols-outlined text-[18px]\">account_circle</span>\n                </div>\n              </div>\n            );\n          }\n\n          // Structured Diagnostic Verdict Message\n          if (msg.isStructuredVerdict) {\n            return (\n              <div key={msg.id} className=\"flex items-start gap-2.5 w-full\">\n                <div className=\"w-8 h-8 rounded-lg bg-[#a078ff]/20 text-[#d0bcff] flex items-center justify-center shrink-0 mt-1 shadow-sm\">\n                  <span className=\"material-symbols-outlined text-[18px]\">security</span>\n                </div>\n                <div className=\"flex flex-col w-full bg-[#141b2b] rounded-xl rounded-tl-none p-3.5 shadow-xl space-y-3 text-[#dce2f7] border border-[#232a3a]\">\n                  {/* Header Pill & Confidence Score */}\n                  <div className=\"flex items-center justify-between border-b pb-2 border-[#232a3a]\">\n                    <div className=\"flex items-center gap-1.5\">\n                      <span className=\"w-2 h-2 rounded-full bg-[#ff5451] animate-pulse\" />\n                      <span className=\"font-label-sm text-[10px] uppercase font-bold text-[#ffb3ad]\">\n                        {msg.verdictTitle || \'CRITICAL PHISHING VERDICT\'}\n                      </span>\n                    </div>\n                    <span className=\"font-label-sm text-[10px] text-[#4fdbc8] bg-[#070e1d] px-2 py-0.5 rounded-full font-bold font-mono\">\n                      {msg.confidence || \'99.8% CONFIDENCE\'}\n                    </span>\n                  </div>\n\n                  <div className=\"font-code-md text-xs text-[#cbc3d7] leading-relaxed space-y-2\">\n                    <p className=\"text-[#dce2f7] font-semibold\">\n                      Classification Rationale for{\' \'}\n                      <span\n                        className=\"text-[#ffb3ad] cursor-pointer underline decoration-[#ffb3ad]/50 hover:text-white\"\n                        onClick={() => msg.verdictDomain && onInspectUrl(msg.verdictDomain)}\n                      >\n                        {msg.verdictDomain}\n                      </span>\n                      :\n                    </p>\n\n                    {msg.findings?.map((f, idx) => (\n                      <div key={idx} className=\"bg-[#070e1d] p-2.5 rounded-lg space-y-0.5 border border-[#232a3a]\">\n                        <div className=\"flex items-center gap-1.5 text-[#dce2f7] font-bold text-[11px]\">\n                          <span className=\"material-symbols-outlined text-[#ffb3ad] text-[14px]\">\n                            {f.icon}\n                          </span>\n                          {f.title}\n                        </div>\n                        <p className=\"text-body-sm text-[11px] text-[#cbc3d7]\">{f.desc}</p>\n                      </div>\n                    ))}\n                  </div>\n\n                  {/* Remediation Recommendation Card */}\n                  <div className=\"bg-[#2e3545]/60 rounded-lg p-3 space-y-1.5 border border-[#232a3a]\">\n                    <div className=\"flex items-center gap-1.5 text-[#4fdbc8] font-label-md text-[11px] uppercase font-bold\">\n                      <span className=\"material-symbols-outlined text-[16px]\">shield_with_heart</span>\n                      SENTINEL MITIGATION RECOMMENDATION\n                    </div>\n                    <p className=\"font-body-sm text-xs text-[#dce2f7] leading-snug\">\n                      {msg.recommendation}\n                    </p>\n                    <div className=\"flex items-center gap-2 pt-1.5\">\n                      <button\n                        onClick={() => handleSinkhole(msg.verdictDomain)}\n                        className=\"flex items-center gap-1 px-3 py-1.5 bg-[#ff5451] hover:bg-[#ff5451]/90 text-white rounded-lg font-label-sm text-[10px] font-bold active:opacity-80 transition-opacity\"\n                      >\n                        <span className=\"material-symbols-outlined text-[14px]\">block</span>\n                        EXECUTE SINKHOLE\n                      </button>\n                      <button\n                        onClick={() => handleShareTicket(msg.verdictDomain)}\n                        className=\"flex items-center gap-1 px-3 py-1.5 bg-[#191f2f] hover:bg-[#232a3a] text-[#dce2f7] rounded-lg font-label-sm text-[10px] font-semibold transition-colors border border-[#232a3a]\"\n                      >\n                        <span className=\"material-symbols-outlined text-[14px]\">ios_share</span>\n                        SHARE SIEM TICKET\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            );\n          }\n\n          return null;\n        })}\n\n        {isThinking && (\n          <div className=\"flex items-start gap-2.5 max-w-[95%]\">\n            <div className=\"w-8 h-8 rounded-lg bg-[#a078ff]/20 text-[#d0bcff] flex items-center justify-center shrink-0 mt-1\">\n              <span className=\"material-symbols-outlined text-[18px] animate-spin\">refresh</span>\n            </div>\n            <div className=\"bg-[#141b2b] rounded-xl rounded-tl-none p-3 shadow-md text-xs text-[#cbc3d7] flex items-center gap-2 border border-[#232a3a]\">\n              <span className=\"w-2 h-2 rounded-full bg-[#d0bcff] animate-ping\" />\n              <span>Analyzing neural threat telemetry & querying IOC databases...</span>\n            </div>\n          </div>\n        )}\n\n        <div ref={messagesEndRef} />\n      </section>\n\n      {/* Suggested Quick Tactical Prompt Chips */}\n      <section className=\"flex flex-col w-full space-y-1.5\">\n        <span className=\"font-label-sm text-[10px] text-[#958ea0] uppercase tracking-wider px-1 font-mono\">\n          Tactical Analysis Prompts\n        </span>\n        <div className=\"flex items-center gap-2 overflow-x-auto pb-1.5 scrollbar-none\">\n          {[\n            { label: \'Explain Punycode attack vectors\', icon: \'psychology_alt\', color: \'text-[#d0bcff]\' },\n            { label: \'How to spot fake OAuth consent?\', icon: \'verified_user\', color: \'text-[#4fdbc8]\' },\n            { label: \'Analyze DKIM/DMARC headers\', icon: \'mark_email_read\', color: \'text-[#d0bcff]\' },\n            { label: \'Generate YARA rule for this URL\', icon: \'code\', color: \'text-[#4fdbc8]\' },\n          ].map((chip, idx) => (\n            <button\n              key={idx}\n              onClick={() => handleSendMessage(chip.label)}\n              className=\"prompt-chip shrink-0 px-3 py-1.5 rounded-full bg-[#141b2b] hover:bg-[#191f2f] text-[#cbc3d7] hover:text-[#d0bcff] font-label-md text-[11px] transition-colors flex items-center gap-1.5 shadow-sm border border-[#232a3a]\"\n            >\n              <span className={`material-symbols-outlined text-[14px] ${chip.color}`}>\n                {chip.icon}\n              </span>\n              <span>{chip.label}</span>\n            </button>\n          ))}\n        </div>\n      </section>\n\n      {/* Multimodal Chat & Voice Input Dock */}\n      <section className=\"flex items-center gap-2 w-full bg-[#141b2b] p-2 rounded-xl shadow-2xl sticky bottom-20 z-30 border border-[#232a3a]\">\n        <button\n          aria-label=\"Hold to speak voice command\"\n          onClick={() => {\n            setVoiceActive(true);\n            onShowToast(\'Voice recognition channel engaged.\');\n          }}\n          className=\"relative group flex items-center justify-center w-11 h-11 rounded-lg bg-[#191f2f] text-[#d0bcff] hover:text-[#4fdbc8] active:scale-95 transition-all shadow-[0_0_12px_rgba(160,120,255,0.2)] border border-[#232a3a]\"\n        >\n          <span className=\"material-symbols-outlined text-[20px]\">mic</span>\n          <span className=\"absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-[#d0bcff] animate-ping\" />\n        </button>\n\n        <button\n          aria-label=\"Attach Packet Log or Header\"\n          onClick={() => {\n            onShowToast(\'Packet attachment simulator ready (PCAP/HTTP stream).\');\n          }}\n          className=\"flex items-center justify-center w-9 h-9 rounded-lg bg-[#191f2f] text-[#cbc3d7] hover:text-[#dce2f7] transition-colors border border-[#232a3a]\"\n        >\n          <span className=\"material-symbols-outlined text-[18px]\">attach_file</span>\n        </button>\n\n        {/* Omnibar Text Input */}\n        <div className=\"relative flex-1\">\n          <input\n            id=\"sentinel-chat-input\"\n            type=\"text\"\n            value={inputValue}\n            onChange={(e) => setInputValue(e.target.value)}\n            onKeyDown={(e) => e.key === \'Enter\' && handleSendMessage()}\n            placeholder=\"Ask Sentinel AI or type a suspicious URL...\"\n            className=\"w-full h-11 bg-[#070e1d] text-[#dce2f7] placeholder:text-[#958ea0] font-body-sm text-xs rounded-lg pl-3 pr-8 focus:outline-none focus:ring-1 focus:ring-[#d0bcff] shadow-inner border border-[#232a3a]\"\n          />\n          <span className=\"absolute right-2.5 top-3 material-symbols-outlined text-[#958ea0] text-[16px] pointer-events-none\">\n            travel_explore\n          </span>\n        </div>\n\n        {/* Violet Transmit Action Button */}\n        <button\n          id=\"sentinel-send-btn\"\n          aria-label=\"Send telemetry query\"\n          onClick={() => handleSendMessage()}\n          className=\"flex items-center justify-center w-11 h-11 rounded-lg bg-[#a078ff] hover:bg-[#a078ff]/90 text-[#340080] shadow-[0_0_16px_rgba(160,120,255,0.4)] active:scale-95 transition-all\"\n        >\n          <span\n            className=\"material-symbols-outlined text-[20px]\"\n            style={{ fontVariationSettings: \"\'FILL\' 1\" }}\n          >\n            send\n          </span>\n        </button>\n      </section>\n    </div>\n  );\n}\n"
